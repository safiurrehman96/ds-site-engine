---
/**
 * Renders a run of blocks that lib/compose.ts has already assigned compositions to.
 *
 * The switch below is the only place a composition becomes a component. Recipes ask
 * composeBlocks() what each block should be and hand the answer here, so "callout
 * means Callout, photo means SplitSection with a variant" is decided once rather
 * than re-implemented — differently — in every recipe.
 */
import type { ComposableBlock, Composed } from '../lib/compose';
import SplitSection from './SplitSection.astro';
import Callout from './Callout.astro';

interface Props {
  entries: Composed<ComposableBlock>[];
  /** Optional tone override; defaults to alternating with the block's split index. */
  tone?: 'paper' | 'card';
  /** Credential badge, attached to the first block only (About's About-us slot). */
  badge?: { image: string; alt: string; href?: string };
}

const { entries, tone, badge } = Astro.props;
---

{
  entries.map((entry, i) =>
    entry.kind === 'callout' ? (
      <Callout heading={entry.block.heading} body={entry.block.body} cta={entry.block.cta} />
    ) : (
      <SplitSection
        index={entry.index}
        variant={entry.kind === 'photo' ? entry.variant : undefined}
        layout={entry.kind === 'copy' ? entry.layout : undefined}
        tone={tone ?? (entry.index % 2 === 0 ? 'paper' : 'card')}
        heading={entry.block.heading}
        body={entry.block.body}
        image={entry.block.image}
        cta={entry.block.cta}
        badge={i === 0 ? badge : undefined}
      />
    ),
  )
}
