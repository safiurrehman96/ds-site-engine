---
/**
 * A short, high-contrast statement on an accent panel.
 *
 * Exists because a page of SplitSections has no way to raise its voice. Every other
 * block is ink-on-paper at the same weight, so a run of them flattens into one tone
 * however the copy is laid out — the failure the About page kept exhibiting. This is
 * the counterweight: full accent fill, a single short statement, no photo.
 *
 * Deliberately unsuited to long copy. The panel is capped at a narrow measure and the
 * recipe only reaches for it on a genuinely short block, because an accent field
 * behind six lines of body text stops being emphasis and becomes a legibility
 * problem — `--ds-on-accent` is contrast-validated for the fill, but a wall of it is
 * still a wall.
 */
import Prose from './Prose.astro';

interface Props {
  heading: string;
  body: string;
  cta?: { label: string; href: string };
  eyebrow?: string;
}

const { heading, body, cta, eyebrow } = Astro.props;
---

<section class="callout ds-section">
  <div class="ds-container">
    <div class="panel">
      {eyebrow && <p class="ds-kicker">{eyebrow}</p>}
      <h2>{heading}</h2>
      <Prose body={body} class="body" />

      {
        cta && (
          <p class="cta">
            <a class="ds-btn" href={cta.href}>
              {cta.label}
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .panel {
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem);
    border-radius: var(--ds-radius-lg);
    background: var(--ds-accent);
    color: var(--ds-on-accent);
    box-shadow: var(--ds-shadow-lg);
  }

  .panel h2 {
    max-width: 22ch;
    color: inherit;
  }

  /* The kicker's accent-on-paper colour is invisible on the accent fill itself. */
  .panel :global(.ds-kicker) {
    color: inherit;
    opacity: 0.75;
  }

  .panel :global(.ds-kicker::before),
  .panel :global(.ds-kicker::after) {
    background: currentColor;
  }

  /* Stamp head motif draws an accent-filled chip, which vanishes on an accent panel. */
  :global([data-head='stamp']) .panel :global(.ds-kicker) {
    background: color-mix(in srgb, var(--ds-on-accent) 18%, transparent);
  }

  .panel :global(.body) {
    max-width: 62ch;
    margin-top: 1rem;
    color: inherit;
    opacity: 0.92;
    font-size: 1.0625rem;
  }

  /* Links inside the statement have only the fill to sit on. */
  .panel :global(.body a) {
    color: inherit;
    text-decoration-thickness: 2px;
  }

  .cta {
    margin-top: 1.75rem;
  }

  /*
   * The button sits on the accent, so neither .ds-btn--primary (accent fill) nor
   * --secondary (accent outline) reads. An on-accent solid does, and it inverts the
   * pair: the panel's own colour becomes the button's fill.
   */
  .cta .ds-btn {
    background: var(--ds-on-accent);
    color: var(--ds-accent);
    border-color: var(--ds-on-accent);
  }

  .cta .ds-btn:hover {
    background: color-mix(in srgb, var(--ds-on-accent) 88%, var(--ds-accent));
  }
</style>
