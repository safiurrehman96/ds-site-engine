---
/**
 * Announcement strip: hours + service-area line + socials (spec §04).
 *
 * Deliberately no phone number — the header directly below already carries it
 * twice (desktop CTA, mobile call button), so this strip surfaces the two facts
 * the header has no room for: when the business is open and where it works.
 * Both come from required config fields, so there is nothing extra to author;
 * a client it doesn't suit disables the whole strip via modules.topBar.
 */
import SocialLinks from './SocialLinks.astro';
import { siteConfig } from '../lib/site-config';

const { hours, serviceArea } = siteConfig;

const hoursLine = `Open ${hours.map((h) => `${h.days} ${h.hours}`).join(' · ')}`;
const areaLine = `Serving ${serviceArea.label}`;
---

<div class="topbar ds-deep-surface">
  <div class="ds-container inner">
    <p class="facts">
      <span class="fact">{hoursLine}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="fact">{areaLine}</span>
    </p>
    <SocialLinks size={16} />
  </div>
</div>

<style>
  .topbar {
    background: var(--ds-deep);
    color: var(--ds-on-deep);
    font-size: 0.875rem;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding-block: 0.375rem;
  }

  .facts {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 0.5rem;
    font-family: var(--ds-font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .fact {
    white-space: nowrap;
  }

  /* Below 640px one fact is plenty; keep the hours, drop the rest. */
  @media (max-width: 640px) {
    .sep,
    .fact:last-of-type {
      display: none;
    }
    .inner {
      justify-content: center;
    }
  }
</style>
