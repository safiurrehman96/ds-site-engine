---
/**
 * Numbered process. Serves both "How It Works" on home and "Our {Service} Process"
 * on service pages, hence the optional per-step title.
 *
 * Four layouts, selected by the preset's `stepsStyle` motif and overridable per page.
 * All share one markup structure; only CSS differs. The previous single layout was a
 * four-column grid, which broke down at 5–6 steps (wrapping 4+2) and read as a bland
 * list when steps had no titles.
 */
import type { Preset } from '../config-schema';
import Img from './Img.astro';
import Inline from './Inline.astro';
import { getPreset } from '../styles/presets';
import { activePreset } from '../lib/theme';
import { siteConfig } from '../lib/site-config';

type StepsVariant = 'timeline' | 'track' | 'numerals' | 'ledger';

interface Props {
  /** Small label above the heading. Set to "" to hide. */
  kicker?: string;
  heading: string;
  intro?: string;
  steps: Array<{
    title?: string;
    body: string;
    image?: { src: string; alt: string };
  }>;
  note?: string;
  tone?: 'paper' | 'card';
  /** Overrides the preset's layout. */
  variant?: StepsVariant;
  /** Render under a preset other than the configured one (styleguide only). */
  preset?: Preset;
}

const {
  heading,
  intro,
  steps,
  note,
  tone = 'card',
  variant,
  preset,
  kicker = 'Process',
} = Astro.props;

const active: StepsVariant =
  variant ?? getPreset(preset ?? activePreset).motif.stepsStyle;
---

<section class="steps ds-section" data-tone={tone} data-variant={active}>
  <div class="ds-container">
    <div class="head">
      {kicker && <p class="ds-kicker">{kicker}</p>}
      <h2>{heading}</h2>
      {intro && <p class="ds-lede">{intro}</p>}
    </div>

    <ol class="list">
      {
        steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {
              step.image && (
                <div class="media">
                  <Img
                    src={step.image.src}
                    alt={step.image.alt}
                    widths={[320, 480, 768]}
                    sizes="(min-width: 700px) 30vw, 100vw"
                  />
                </div>
              )
            }
            <div class="copy">
              {step.title && <h3>{step.title}</h3>}
              <p><Inline text={step.body} /></p>
            </div>
          </li>
        ))
      }
    </ol>

    {note && <p class="note">{note}</p>}
  </div>
</section>

<style>
  .steps[data-tone='card'] {
    background: var(--ds-card);
  }

  .head {
    max-width: 62ch;
    margin-bottom: 2.5rem;
  }

  .head .ds-lede {
    margin-top: 0.75rem;
  }

  .list {
    display: grid;
    counter-reset: step;
  }

  /* Per-step photo, shared by every variant; each layout only decides where the
     block sits. Fixed 3:2 crop so uneven source photos can't break row alignment. */
  .media {
    overflow: hidden;
    border-radius: var(--ds-radius-sm);
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .copy h3 {
    margin-bottom: 0.25rem;
  }

  .copy p {
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
  }

  .note {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--ds-accent);
    background: var(--ds-paper);
    border-radius: var(--ds-radius-sm);
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
    max-width: 76ch;
  }

  .steps[data-tone='paper'] .note {
    background: var(--ds-card);
  }

  /* ================= timeline — vertical rail with a connecting line ============= */

  .steps[data-variant='timeline'] .list {
    gap: 0;
    max-width: 60rem;
  }

  .steps[data-variant='timeline'] li {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .steps[data-variant='timeline'] li:last-child {
    padding-bottom: 0;
  }

  /* The rail: a line from this dot down to the next one. */
  .steps[data-variant='timeline'] li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.5rem;
    top: 3rem;
    bottom: 0;
    width: 2px;
    transform: translateX(-1px);
    background: color-mix(in srgb, var(--ds-accent) 30%, transparent);
  }

  .steps[data-variant='timeline'] .num {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--ds-radius-pill);
    background: var(--ds-accent);
    color: var(--ds-on-accent);
    font-family: var(--ds-font-display);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .steps[data-variant='timeline'] .copy {
    padding-top: 0.5rem;
  }

  /* The photo shares the copy column, capped so it reads as an illustration of the
     step rather than a full split-section image. */
  .steps[data-variant='timeline'] .media {
    grid-column: 2;
    max-width: 26rem;
    margin-bottom: 1rem;
  }

  /* Three children in a two-column grid: the copy must be pinned to the copy column
     or auto-placement drops it under the number. */
  .steps[data-variant='timeline'] li:has(.media) .copy {
    grid-column: 2;
  }

  /* ================= track — horizontal line through the numbers ================= */

  .steps[data-variant='track'] .list {
    grid-auto-flow: row;
    gap: 2rem 1.5rem;
    grid-template-columns: 1fr;
  }

  .steps[data-variant='track'] li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .steps[data-variant='track'] .num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--ds-radius-pill);
    border: 2px solid var(--ds-accent);
    background: var(--ds-card);
    color: var(--ds-accent-ink);
    font-family: var(--ds-font-display);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .steps[data-variant='track'] .media {
    grid-column: 2;
    margin-bottom: 0.75rem;
  }

  .steps[data-variant='track'] li:has(.media) .copy {
    grid-column: 2;
  }

  @media (min-width: 860px) {
    .steps[data-variant='track'] .list {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 0;
    }

    .steps[data-variant='track'] li {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-inline: 1rem;
      text-align: center;
      justify-items: center;
      /* Pack rows to the top. Without this the li stretches to the tallest column
         and the auto rows stretch with it, so short copy floats to the middle and
         the first lines no longer align across columns. */
      align-content: start;
    }

    /* The connecting line, drawn behind the dots. */
    .steps[data-variant='track'] li:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 1.375rem;
      left: 50%;
      width: 100%;
      height: 2px;
      transform: translateY(-1px);
      background: color-mix(in srgb, var(--ds-accent) 28%, transparent);
    }

    .steps[data-variant='track'] .num {
      position: relative;
      z-index: 1;
    }

    .steps[data-variant='track'] .media {
      grid-column: auto;
      width: 100%;
      margin-bottom: 0;
    }

    .steps[data-variant='track'] li:has(.media) .copy {
      grid-column: auto;
    }
  }

  /* ================= numerals — oversized ghosted numbers ======================== */

  .steps[data-variant='numerals'] .list {
    gap: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .steps[data-variant='numerals'] .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .steps[data-variant='numerals'] .list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* The numeral is a watermark the copy sits *below*, not behind. Overlapping the
     two makes the body text unreadable — digits have no descenders, so clearing
     ~0.82em of the numeral's own size is enough to tuck the copy up close without
     any collision. */
  .steps[data-variant='numerals'] li {
    --num-size: clamp(3rem, 2.2rem + 2.4vw, 4.5rem);
    position: relative;
    padding-top: calc(var(--num-size) * 0.88);
  }

  .steps[data-variant='numerals'] .num {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    font-family: var(--ds-font-display);
    font-size: var(--num-size);
    font-weight: 700;
    /* Sub-1 line-height so the box hugs the digits; digits have no descenders,
       so this keeps the copy's clearance tight without any collision. */
    line-height: 0.8;
    /*
     * 55%, not the 26% this shipped with. The ghost is meant to be quiet, but at 26%
     * it measured 1.59:1 on paper and 1.64:1 on card — against the 3.0 that WCAG
     * 1.4.3 asks of large text, which this is at ~70px/700. It failed on every tone,
     * so it had been failing wherever `bold` (the preset whose stepsStyle is
     * numerals) was configured; the service page only surfaced it by opting in on a
     * page the stress gate samples. 55% clears 3.0 with a little room and still
     * reads as a muted ordinal rather than a solid accent number.
     */
    color: color-mix(in srgb, var(--ds-accent) 55%, transparent);
    pointer-events: none;
  }

  /* A short accent rule ties the numeral to its copy. */
  .steps[data-variant='numerals'] li::after {
    content: '';
    position: absolute;
    top: calc(var(--num-size) * 0.4);
    left: calc(var(--num-size) * 1.15);
    right: 0;
    height: 1px;
    background: color-mix(in srgb, var(--ds-accent) 25%, transparent);
  }

  .steps[data-variant='numerals'] .copy {
    position: relative;
    z-index: 1;
  }

  /* The photo slots between the watermark numeral and the copy; it sits above the
     accent rule's plane, so it needs its own stacking context to stay clickable-
     looking and clean of the hairline. */
  .steps[data-variant='numerals'] .media {
    position: relative;
    z-index: 1;
    margin-bottom: 1rem;
  }

  /* ================= ledger — full-width rows with hairline rules ================ */

  .steps[data-variant='ledger'] .list {
    gap: 0;
    border-top: 1px solid var(--ds-line);
    max-width: 68rem;
  }

  .steps[data-variant='ledger'] li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ds-line);
    transition: background-color 0.15s ease;
  }

  @media (min-width: 760px) {
    .steps[data-variant='ledger'] li {
      grid-template-columns: 5rem 1fr;
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }

  .steps[data-variant='ledger'] .media {
    grid-column: 2;
    max-width: 22rem;
    margin-bottom: 0.75rem;
  }

  .steps[data-variant='ledger'] li:has(.media) {
    align-items: start;
  }

  .steps[data-variant='ledger'] li:has(.media) .copy {
    grid-column: 2;
  }

  /* With a photo the baseline alignment stops making sense — the thumb becomes a
     third column and everything tops-out instead. */
  @media (min-width: 760px) {
    .steps[data-variant='ledger'] li:has(.media) {
      grid-template-columns: 5rem 11rem 1fr;
      align-items: start;
    }

    .steps[data-variant='ledger'] li:has(.media) .media {
      max-width: none;
    }

    .steps[data-variant='ledger'] li:has(.media) .copy {
      grid-column: 3;
    }
  }

  .steps[data-variant='ledger'] li:hover {
    background: color-mix(in srgb, var(--ds-accent) 5%, transparent);
  }

  .steps[data-variant='ledger'] .num {
    font-family: var(--ds-font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ds-accent-ink);
  }

  .steps[data-variant='ledger'] .copy p {
    font-size: 1rem;
    color: var(--ds-ink);
  }

  .steps[data-variant='ledger'] .copy h3 + p {
    color: var(--ds-ink-soft);
  }
</style>
