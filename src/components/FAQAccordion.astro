---
/**
 * Q&A block. Native <details>/<summary> — no JS.
 *
 * This renders the UI only. FAQPage JSON-LD belongs in <head>, so pages pass
 * the same faqs through `faqPageJsonLd()` into BaseLayout's `jsonLd` prop.
 * Keeping the two separate avoids emitting structured data from mid-document.
 */
interface Props {
  /** Small label above the heading. Set to "" to hide. */
  kicker?: string;
  heading?: string;
  intro?: string;
  /** Flat list, or grouped sections as used on the site-level /faqs page. */
  faqs?: Array<{ q: string; a: string }>;
  groups?: Array<{ heading: string; faqs: Array<{ q: string; a: string }> }>;
  tone?: 'paper' | 'card';
}

const {
  heading = 'Frequently Asked Questions',
  intro,
  faqs,
  groups,
  tone = 'paper',
  kicker = 'Questions',
} = Astro.props;

const sections = groups ?? (faqs ? [{ heading: '', faqs }] : []);
---

<section class="faq ds-section" data-tone={tone}>
  <div class="ds-container">
    <div class="head">
      {kicker && <p class="ds-kicker">{kicker}</p>}
      <h2>{heading}</h2>
      {intro && <p class="ds-lede">{intro}</p>}
    </div>

    {
      sections.map((section) => (
        <div class="group">
          {section.heading && <h3 class="group-title">{section.heading}</h3>}
          <ul class="list">
            {section.faqs.map((f) => (
              <li>
                <details>
                  <summary>
                    <span class="q">{f.q}</span>
                    <span class="icon" aria-hidden="true" />
                  </summary>
                  <div class="a">
                    <p>{f.a}</p>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq[data-tone='card'] {
    background: var(--ds-card);
  }

  .head {
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .head .ds-lede {
    margin-top: 0.75rem;
  }

  .group + .group {
    margin-top: 2.25rem;
  }

  .group-title {
    margin-bottom: 0.875rem;
    color: var(--ds-accent-ink);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .list {
    display: grid;
    gap: 0.625rem;
    max-width: 80ch;
  }

  details {
    background: var(--ds-card);
    border: var(--ds-border);
    border-radius: var(--ds-radius-md);
    overflow: hidden;
  }

  .faq[data-tone='card'] details {
    background: var(--ds-paper);
  }

  details[open] {
    border-color: color-mix(in srgb, var(--ds-accent) 45%, var(--ds-line));
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .q {
    color: var(--ds-accent-ink);
  }

  .q {
    font-family: var(--ds-font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  /* Plus → minus, drawn with borders so there is no icon request. */
  .icon {
    position: relative;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--ds-accent);
    transition: transform 0.15s ease;
  }

  .icon::after {
    transform: rotate(90deg);
  }

  details[open] .icon::after {
    transform: rotate(0deg);
  }

  .a {
    padding: 0 1.25rem 1.125rem;
    color: var(--ds-ink-soft);
    max-width: 72ch;
  }
</style>
