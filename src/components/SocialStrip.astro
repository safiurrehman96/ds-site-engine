---
/** Follow section: heading + icons, optionally alongside a lifestyle photo. */
import Img from './Img.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  heading?: string;
  image?: { src: string; alt: string };
}

const { heading = 'Follow Us On Social Media', image } = Astro.props;
---

<section class="strip ds-section ds-deep-surface" data-tone="deep" data-media={image ? 'yes' : 'no'}>
  <div class="ds-container inner">
    <div class="copy">
      <h2>{heading}</h2>
      <p class="sub">
        See recent details, before-and-afters, and what we are working on this week.
      </p>
      <SocialLinks size={22} class="icons" />
    </div>

    {
      image && (
        <div class="media">
          <Img
            src={image.src}
            alt={image.alt}
            widths={[480, 768, 1024]}
            sizes="(min-width: 900px) 46vw, 100vw"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .strip {
    background: var(--ds-deep);
    color: var(--ds-on-deep);
  }

  .inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .strip[data-media='yes'] .inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sub {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--ds-on-deep-soft);
  }

  .copy :global(.icons) {
    margin-top: 1.5rem;
  }

  /* Client photography is often dark; on a dark band it disappears without a
     frame. The offset accent block gives the image an edge to read against. */
  .media {
    position: relative;
  }

  .media::before {
    content: '';
    position: absolute;
    inset: 1rem 1rem -1rem -1rem;
    border-radius: var(--ds-radius-lg);
    background: color-mix(in srgb, var(--ds-accent) 55%, transparent);
  }

  @media (max-width: 640px) {
    .media::before {
      display: none;
    }
  }

  .media :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--ds-radius-lg);
    outline: 1px solid color-mix(in srgb, var(--ds-on-deep) 22%, transparent);
    outline-offset: -1px;
  }

  /* Without an image the band would be mostly empty space. */
  .strip[data-media='no'] {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .strip[data-media='no'] .copy {
    max-width: 62ch;
  }
</style>
