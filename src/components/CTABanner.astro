---
/**
 * Closing conversion band. Appears on every page, so its treatment is one of the
 * strongest per-preset signals in the system.
 *
 * Four variants, selected by the preset's `ctaStyle` motif and overridable per page.
 * `deep` carries the `ds-deep-surface` class, so it picks up whichever signature
 * texture the preset already defines (glow / grid / sheen / dots) — the pattern
 * background comes free rather than being re-invented here.
 *
 * Headline comes from the payload; CTAs come from config.
 */
import type { Preset } from '../config-schema';
import Inline from './Inline.astro';
import Img from './Img.astro';
import { getPreset } from '../styles/presets';
import { activePreset } from '../lib/theme';
import { siteConfig } from '../lib/site-config';

type CTAVariant = 'tint' | 'deep' | 'image' | 'panel';

interface Props {
  headline: string;
  body?: string;
  /** Overrides the preset's treatment. */
  variant?: CTAVariant;
  /** Render under a preset other than the configured one (styleguide only). */
  preset?: Preset;
  /** Background photo for the `image` variant. */
  image?: { src: string; alt: string };
}

const { headline, body, variant, preset, image } = Astro.props;

const { contact, defaults } = siteConfig;
const active: CTAVariant = variant ?? getPreset(preset ?? activePreset).motif.ctaStyle;
const bg = image ?? defaults.heroVideo.poster;
---

<section
  class:list={['cta', 'ds-section', active === 'deep' && 'ds-deep-surface']}
  data-variant={active}
  data-tone={active === 'deep' ? 'deep' : undefined}
>
  {
    active === 'image' && (
      <div class="bg">
        <Img
          src={bg.src}
          alt=""
          widths={[768, 1200, 1800]}
          sizes="100vw"
          class="bg-img"
        />
      </div>
    )
  }

  <div class="ds-container">
    <div class="inner">
      <div class="copy">
        <h2>{headline}</h2>
        {body && <p class="ds-lede body"><Inline text={body} /></p>}
      </div>

      <div class="btns">
        <a class="ds-btn ds-btn--primary" href="/booking">Book Today</a>
        <a class="ds-btn ds-btn--secondary" href="/get-quote">Get A Quote</a>
        <a class="ds-btn ds-btn--secondary" href={`tel:${contact.phone}`}>
          Call {contact.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
  }

  .inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .body {
    margin-top: 0.75rem;
    max-width: 54ch;
    color: inherit;
    opacity: 0.92;
  }

  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 420px) {
    .btns .ds-btn {
      width: 100%;
    }
  }

  /* Side-by-side for the left-aligned variants. */
  @media (min-width: 900px) {
    /* `auto` for the button column, not a fraction: three buttons in a 1fr column
       get squeezed and wrap onto two rows. */
    .cta:is([data-variant='tint'], [data-variant='deep']) .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }

    .cta:is([data-variant='tint'], [data-variant='deep']) .btns {
      justify-content: flex-end;
    }
  }

  /* Centred for the image and panel variants. */
  .cta:is([data-variant='image'], [data-variant='panel']) .inner {
    justify-items: center;
    text-align: center;
  }

  .cta:is([data-variant='image'], [data-variant='panel']) .btns {
    justify-content: center;
  }

  .cta:is([data-variant='image'], [data-variant='panel']) .body {
    margin-inline: auto;
  }

  /* ================= tint — soft accent wash ================= */

  .cta[data-variant='tint'] {
    background: color-mix(in srgb, var(--ds-accent) 10%, var(--ds-paper));
    border-top: 1px solid color-mix(in srgb, var(--ds-accent) 22%, transparent);
  }

  /* ================= deep — dark band + the preset's texture ================= */

  .cta[data-variant='deep'] {
    background: var(--ds-deep);
    color: var(--ds-on-deep);
  }

  /* ================= image — full-bleed photo behind a scrim ================= */

  .cta[data-variant='image'] {
    background: var(--ds-deep);
    color: var(--ds-on-deep);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
  }

  .cta[data-variant='image'] .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .cta[data-variant='image'] .bg :global(.bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Flat scrim: the copy is centred, so it needs even darkness rather than a
     gradient — same reasoning as the AreasGrid tiles. */
  .cta[data-variant='image'] .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ds-deep) 62%, transparent) 0%,
        color-mix(in srgb, var(--ds-deep) 78%, transparent) 100%
      ),
      color-mix(in srgb, var(--ds-deep) 30%, transparent);
  }

  /* ================= panel — a contained solid block ================= */

  .cta[data-variant='panel'] {
    background: var(--ds-paper);
  }

  .cta[data-variant='panel'] .inner {
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) clamp(1.25rem, 1rem + 2vw, 3rem);
    background: var(--ds-accent);
    color: var(--ds-on-accent);
    border: var(--ds-border);
    border-radius: var(--ds-radius-lg);
    box-shadow: 10px 10px 0 var(--ds-ink);
  }

  /* On an accent fill the secondary button needs a solid surface to stay legible. */
  .cta[data-variant='panel'] .btns :global(.ds-btn--secondary) {
    background: var(--ds-card);
    border-color: var(--ds-card);
  }

  .cta[data-variant='panel'] .btns :global(.ds-btn--primary) {
    background: var(--ds-ink);
    color: var(--ds-card);
  }
</style>
