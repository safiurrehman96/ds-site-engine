---
/**
 * Add-on services. Count varies by client and service — Kleen has 8 on auto
 * detailing and 2 on the specialty pages — so the grid is count-agnostic.
 */
import Img from './Img.astro';

interface Props {
  /** Small label above the heading. Set to "" to hide. */
  kicker?: string;
  heading?: string;
  intro?: string;
  addons: Array<{ name: string; body: string; image?: { src: string; alt: string } }>;
  tone?: 'paper' | 'card';
}

const { heading = 'Add-On Services', intro, addons, tone = 'card',
  kicker = 'Add-ons',
} = Astro.props;
const hasImages = addons.some((a) => a.image);
---

<section class="addons ds-section" data-tone={tone} data-media={hasImages ? 'yes' : 'no'}>
  <div class="ds-container">
    <div class="head">
      {kicker && <p class="ds-kicker">{kicker}</p>}
      <h2>{heading}</h2>
      {intro && <p class="ds-lede">{intro}</p>}
    </div>

    <ul class="grid">
      {
        addons.map((a) => (
          <li class="card">
            {a.image && (
              <div class="media">
                <Img
                  src={a.image.src}
                  alt={a.image.alt}
                  widths={[320, 480]}
                  sizes="(min-width: 900px) 30vw, 100vw"
                />
              </div>
            )}
            <div class="body">
              <h3>{a.name}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .addons[data-tone='card'] {
    background: var(--ds-card);
  }

  .head {
    max-width: 62ch;
    margin-bottom: 2.25rem;
  }

  .head .ds-lede {
    margin-top: 0.75rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--ds-paper);
    border: var(--ds-border);
    border-radius: var(--ds-radius-md);
    overflow: hidden;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--ds-accent) 55%, var(--ds-line));
    transform: translateY(-2px);
  }

  .media {
    overflow: hidden;
  }

  .media :global(img) {
    transition: transform 0.45s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .card:hover .media :global(img) {
    transform: scale(1.05);
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .body {
    padding: 1.125rem 1.25rem 1.25rem;
  }

  .body p {
    margin-top: 0.375rem;
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
  }
</style>
