---
/**
 * A service tier. Rendered as a full-width alternating band rather than a
 * pricing column, because packages carry a paragraph of copy, not a feature
 * list — and the clients quote rather than publish prices.
 */
import Img from './Img.astro';
import Prose from './Prose.astro';

interface Props {
  name: string;
  tagline: string;
  body: string;
  durationBadge?: string;
  image?: { src: string; alt: string };
  index?: number;
}

const { name, tagline, body, durationBadge, image, index = 0 } = Astro.props;
const side = index % 2 === 0 ? 'right' : 'left';
---

<article class="pkg" data-side={side} data-media={image ? 'yes' : 'no'}>
  <div class="copy">
    <div class="head">
      <h2>{name}</h2>
      {durationBadge && <span class="badge">{durationBadge}</span>}
    </div>
    <h3 class="tagline">{tagline}</h3>
    <Prose body={body} class="body" />
    <p class="cta">
      <a class="ds-btn ds-btn--primary" href="/booking">Book Today</a>
    </p>
  </div>

  {
    image && (
      <div class="media">
        <Img
          src={image.src}
          alt={image.alt}
          widths={[400, 640, 900]}
          sizes="(min-width: 900px) 42vw, 100vw"
        />
      </div>
    )
  }
</article>

<style>
  .pkg {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    align-items: center;
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.25rem);
    border-bottom: 1px solid var(--ds-line);
  }

  .pkg:last-of-type {
    border-bottom: 0;
  }

  @media (min-width: 900px) {
    .pkg[data-media='yes'] {
      grid-template-columns: 1fr 0.85fr;
    }

    .pkg[data-side='left'] .copy {
      order: 2;
    }
  }

  .pkg[data-media='no'] .copy {
    max-width: 72ch;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: var(--ds-radius-pill);
    background: var(--ds-accent);
    color: var(--ds-on-accent);
    font-family: var(--ds-font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tagline {
    margin-top: 0.375rem;
    color: var(--ds-accent-ink);
    font-size: 1.0625rem;
  }

  .copy :global(.body) {
    margin-top: 0.875rem;
    color: var(--ds-ink-soft);
  }

  .cta {
    margin-top: 1.5rem;
  }

  .media {
    overflow: hidden;
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow-lg);
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .pkg:hover .media :global(img) {
    transform: scale(1.04);
  }
</style>
