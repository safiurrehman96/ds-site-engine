---
/**
 * Renders an authored multi-paragraph string.
 *
 * Prose is plain text with two exceptions, both driven by shapes that turn up in real
 * payload copy often enough that flattening them was the single biggest reason
 * copy-only sections read as a wall of grey text (see lib/content.ts for the parse):
 *
 *   - a block whose lines all begin with "- " becomes a real <ul>, and past
 *     LIST_GRID_MIN items it becomes a two-column checklist rather than a thin
 *     ribbon of bullets — service pages list what a job includes, at 4–9 items;
 *   - a run of "**Label.** explanation" paragraphs becomes a labelled <dl> grid.
 *     Nine of nine JetSpa service pages open `whyItMatters` with five of these, and
 *     as paragraphs they were an essay where the author wrote a spec sheet.
 *
 * Nothing else is interpreted; there is no markdown parser here, and payload prose is
 * not markdown. Inline **bold** and [links](/path) are still Inline's job.
 *
 * Both grids are sized by *container* query, not viewport: this component renders
 * into a full-width rail, a half-width column beside a photo, and a PackageCard band,
 * and only the element's own width says whether two columns will fit.
 */
import { proseBlocks, LIST_GRID_MIN } from '../lib/content';
import Inline from './Inline.astro';

interface Props {
  body: string;
  class?: string;
}

const { body, class: className } = Astro.props;

const blocks = proseBlocks(body);
---

<div class:list={['ds-prose', className]}>
  {
    blocks.map((b) =>
      b.kind === 'list' ? (
        <ul class="ds-prose-list" data-grid={b.items.length >= LIST_GRID_MIN ? 'yes' : undefined}>
          {b.items.map((item) => (
            <li>
              <Inline text={item} />
            </li>
          ))}
        </ul>
      ) : b.kind === 'points' ? (
        <dl class="ds-prose-points">
          {b.items.map((p) => (
            <div>
              <dt>{p.label}</dt>
              <dd>
                <Inline text={p.body} />
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p>
          <Inline text={b.text} />
        </p>
      ),
    )
  }
</div>

<style>
  /* The query container for both grids below. Declared on the prose block itself so
     every caller gets the behaviour without opting in. */
  .ds-prose {
    container-type: inline-size;
  }

  /*
   * inline-grid, not grid, and text-align: left regardless of the surrounding
   * block. A copy-only SplitSection centres its column, and a centred bulleted
   * list is unreadable: every line is ragged on both edges and the markers sit
   * off on their own, nowhere near the text they belong to. Shrink-to-fit plus
   * left-aligned items keeps the list centred *as a block* while the rows stay
   * flush, which is what the centring was actually for.
   */
  .ds-prose-list {
    display: inline-grid;
    vertical-align: top;
    max-width: 100%;
    gap: 0.5rem;
    margin-block: 1rem;
    padding-left: 1.25rem;
    text-align: left;
    list-style: disc;
  }

  .ds-prose-list li::marker {
    color: var(--ds-accent);
  }

  /* ---- checklist: a long list is an inventory, so lay it out like one ---- */

  .ds-prose-list[data-grid] {
    display: block;
    padding-left: 0;
    list-style: none;
  }

  /*
   * Multi-column, not a two-column grid. A grid puts items in row-major pairs, so a
   * four-line item beside a one-line item leaves a visible hole in the row — and
   * these lists are exactly that uneven ("Full pre-coating wash and decontamination
   * to remove airborne contaminants…" next to "Curing time and post-application
   * inspection"). Multicol balances by height instead and reads down each column.
   *
   * Spacing is margin-bottom rather than a row gap so the first item in the second
   * column starts level with the first item in the first, instead of carrying a
   * separator margin to the top of its column.
   */
  .ds-prose-list[data-grid] li {
    position: relative;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    break-inside: avoid;
  }

  .ds-prose-list[data-grid] li:last-child {
    margin-bottom: 0;
  }

  /* A drawn chevron, not a glyph: no dependency on the body font shipping U+2713,
     and it stays crisp at whatever size the surrounding copy is set. Centred on the
     first line, whose middle sits at half the copy's 1.6 line-height. */
  .ds-prose-list[data-grid] li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.8em;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid var(--ds-accent);
    border-bottom: 2px solid var(--ds-accent);
    transform: translateY(-50%) rotate(-45deg);
  }

  /* ---- points: labelled rows, divided by hairlines ---- */

  .ds-prose-points {
    display: grid;
    margin-block: 1.25rem;
    text-align: left;
  }

  .ds-prose-points > div {
    padding-block: 1.1rem;
    border-top: 1px solid var(--ds-line);
  }

  .ds-prose-points dt {
    font-family: var(--ds-font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ds-accent-ink);
  }

  .ds-prose-points dd {
    margin: 0.4rem 0 0;
    color: var(--ds-ink-soft);
  }

  /* Two columns once the *container* is wide enough — which the rail layout is and
     the column beside a photo is not. The vertical hairline is the right-hand
     column's left border, so it lands in the gutter without a spare element. */
  @container (min-width: 32rem) {
    .ds-prose-points {
      grid-template-columns: 1fr 1fr;
    }

    .ds-prose-list[data-grid] {
      columns: 2;
      column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    }

    .ds-prose-points > div {
      padding-inline: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    }

    .ds-prose-points > div:nth-child(odd) {
      padding-left: 0;
    }

    .ds-prose-points > div:nth-child(even) {
      padding-right: 0;
      border-left: 1px solid var(--ds-line);
    }
  }

  /* On the dark bands the paper hairline disappears; derive one from the text
     colour instead so the grid keeps its structure. */
  :global(.ds-deep-surface) .ds-prose-points > div,
  :global(.split[data-variant='wide']) .ds-prose-points > div {
    border-color: color-mix(in srgb, var(--ds-on-deep) 22%, transparent);
  }

  :global(.ds-deep-surface) .ds-prose-points dt,
  :global(.split[data-variant='wide']) .ds-prose-points dt {
    color: var(--ds-accent-on-deep);
  }

  :global(.ds-deep-surface) .ds-prose-points dd,
  :global(.split[data-variant='wide']) .ds-prose-points dd {
    color: inherit;
  }
</style>
