---
/**
 * Renders an authored multi-paragraph string.
 *
 * Prose is plain text with one exception: a block whose lines all begin with "- "
 * becomes a real <ul>. Bulleted copy turns out to be unavoidable — service pages
 * routinely list what a job includes — and without this those lines rendered as
 * literal "- item" text inside a paragraph. Nothing else is interpreted; there is no
 * markdown parser here, and payload prose is not markdown.
 */
import { paragraphs } from '../lib/content';
import Inline from './Inline.astro';

interface Props {
  body: string;
  class?: string;
}

const { body, class: className } = Astro.props;

const blocks = paragraphs(body).map((block) => {
  const lines = block.split('\n').map((l) => l.trim()).filter(Boolean);
  const isList = lines.length > 0 && lines.every((l) => l.startsWith('- '));
  return isList ? { type: 'list' as const, items: lines.map((l) => l.slice(2).trim()) } : { type: 'text' as const, text: block };
});
---

<div class:list={['ds-prose', className]}>
  {
    blocks.map((b) =>
      b.type === 'list' ? (
        <ul class="ds-prose-list">
          {b.items.map((item) => (
            <li>
              <Inline text={item} />
            </li>
          ))}
        </ul>
      ) : (
        <p>
          <Inline text={b.text} />
        </p>
      ),
    )
  }
</div>

<style>
  /*
   * inline-grid, not grid, and text-align: left regardless of the surrounding
   * block. A copy-only SplitSection centres its column, and a centred bulleted
   * list is unreadable: every line is ragged on both edges and the markers sit
   * off on their own, nowhere near the text they belong to. Shrink-to-fit plus
   * left-aligned items keeps the list centred *as a block* while the rows stay
   * flush, which is what the centring was actually for.
   */
  .ds-prose-list {
    display: inline-grid;
    vertical-align: top;
    max-width: 100%;
    gap: 0.5rem;
    margin-block: 1rem;
    padding-left: 1.25rem;
    text-align: left;
    list-style: disc;
  }

  .ds-prose-list li::marker {
    color: var(--ds-accent);
  }
</style>
