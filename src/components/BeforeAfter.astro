---
/**
 * Before/after proof block.
 *
 * Renders as a side-by-side pair by default and upgrades to a drag slider only once
 * the script runs. That order matters: a slider is the better sales tool, but it is
 * the variant that needs JS, sized layers, and a pointer. Starting from the pair
 * means no-JS visitors, print, and the moment before hydration all show two complete
 * images rather than one image with an invisible half.
 *
 * `variant="pair"` opts out of the upgrade entirely.
 */
import Img from './Img.astro';

interface ImageRef {
  src: string;
  alt: string;
}

interface Props {
  before: ImageRef;
  after: ImageRef;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
  heading?: string;
  variant?: 'slider' | 'pair';
  tone?: 'paper' | 'card';
}

const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  caption,
  heading,
  variant = 'slider',
  tone = 'paper',
} = Astro.props;

// Both layers are the same box, so both get the same widths/sizes. Two images per
// instance counts against the 600KB-per-image budget in integrations/asset-budget.ts.
const widths = [480, 768, 1200];
const sizes = '(min-width: 900px) 46vw, 100vw';
---

<section class="ba-section ds-section" data-tone={tone}>
  <div class="ds-container">
    {heading && <h2 class="ba-heading">{heading}</h2>}

    <figure class="ba" data-variant={variant} data-mode="pair">
      <div class="frame">
        <div class="layer layer--before">
          <Img src={before.src} alt={before.alt} widths={widths} sizes={sizes} />
          <span class="tag">{beforeLabel}</span>
        </div>

        <div class="layer layer--after">
          <Img src={after.src} alt={after.alt} widths={widths} sizes={sizes} />
          <span class="tag tag--after">{afterLabel}</span>
        </div>

        {
          variant === 'slider' && (
            <input
              class="range"
              type="range"
              min="0"
              max="100"
              value="50"
              step="1"
              aria-label={`Reveal more of the ${afterLabel.toLowerCase()} image`}
            />
          )
        }
      </div>

      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  </div>
</section>

{
  variant === 'slider' && (
    <script>
      // Upgrade pair → slider. Runs once; each figure keeps its own position so two
      // blocks on one page do not fight over a shared variable.
      for (const figure of document.querySelectorAll<HTMLElement>(
        '.ba[data-variant="slider"]',
      )) {
        const range = figure.querySelector<HTMLInputElement>('.range');
        if (!range) continue;

        const apply = () => figure.style.setProperty('--pos', `${range.value}%`);
        apply();
        figure.dataset.mode = 'slider';
        range.addEventListener('input', apply);
      }
    </script>
  )
}

<style>
  .ba-heading {
    margin-bottom: 1.5rem;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .frame {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  /* Pair: two complete images. Side by side once there is room for both. */
  @media (min-width: 700px) {
    .ba[data-mode='pair'] .frame {
      grid-template-columns: 1fr 1fr;
    }
  }

  .layer {
    position: relative;
    overflow: hidden;
    border: var(--ds-border);
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow);
  }

  .layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--ds-radius-pill);
    background: var(--ds-deep);
    color: var(--ds-on-deep);
    font-family: var(--ds-font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .tag--after {
    left: auto;
    right: 0.75rem;
    background: var(--ds-accent);
    color: var(--ds-on-accent);
  }

  .range {
    display: none;
  }

  /* Slider: layers stack, the after image is revealed left-to-right by --pos. */
  .ba[data-mode='slider'] .frame {
    position: relative;
    display: block;
  }

  .ba[data-mode='slider'] .layer--after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos, 50%));
  }

  .ba[data-mode='slider'] .layer--after .tag--after {
    /* Keep the label inside the revealed strip rather than under the clip. */
    right: 0.75rem;
  }

  .ba[data-mode='slider'] .range {
    display: block;
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    margin: 0;
    padding: 0;
    /* Sits over the full image so the whole surface is draggable, but only the
       bottom band is visible as a control. */
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
  }

  /* The visible handle: a hairline and grip drawn at --pos, purely decorative —
     the real control is the transparent range input above it. */
  .ba[data-mode='slider'] .frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    width: 2px;
    background: var(--ds-on-accent, #fff);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    pointer-events: none;
  }

  .ba[data-mode='slider'] .range:focus-visible {
    outline: 3px solid var(--ds-accent);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: 0.875rem;
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
  }

  @media print {
    /* Print the pair — a clipped slider prints as half an image. */
    .ba[data-mode='slider'] .frame {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .ba[data-mode='slider'] .layer--after {
      position: static;
      clip-path: none;
    }

    .ba[data-mode='slider'] .frame::after,
    .range {
      display: none;
    }
  }
</style>
