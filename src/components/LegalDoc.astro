---
/** Renders a LegalDocument (Recipe E). Numbering is generated, not authored. */
import type { LegalDocument } from '../lib/legal';
import Inline from './Inline.astro';
import { siteConfig } from '../lib/site-config';

interface Props {
  title: string;
  doc: LegalDocument;
}

const { title, doc } = Astro.props;
const { contact, site, legal } = siteConfig;
---

<article class="legal ds-section">
  <div class="ds-container inner">
    <h1>{title}</h1>
    <p class="effective">Effective Date: {legal.effectiveDate}</p>

    {doc.intro.map((p) => <p class="lede"><Inline text={p} /></p>)}

    {
      doc.sections.map((section, i) => (
        <section class="sec">
          <h2>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            {section.heading}
          </h2>
          {section.body?.map((p) => <p><Inline text={p} /></p>)}
          {section.bullets && (
            <ul class="bullets">
              {section.bullets.map((b) => (
                <li>
                  {b.term ? (
                    <>
                      <strong>{b.term}:</strong> {b.text}
                    </>
                  ) : (
                    b.text
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <section class="sec">
      <h2>{doc.contact.heading}</h2>
      <p><Inline text={doc.contact.intro} /></p>
      <ul class="bullets">
        <li>
          <strong>Phone:</strong>{' '}
          <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
        </li>
        <li>
          <strong>Email:</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li>
          <strong>Website:</strong> <a href={site.url}>{site.url}</a>
        </li>
      </ul>
    </section>
  </div>
</article>

<style>
  .inner {
    max-width: 78ch;
  }

  .effective {
    margin-top: 0.75rem;
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
  }

  .lede {
    margin-top: 1rem;
    color: var(--ds-ink-soft);
    font-size: 1.0625rem;
  }

  .sec {
    margin-top: 2.5rem;
  }

  .sec h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
  }

  .num {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border-radius: var(--ds-radius-pill);
    background: var(--ds-accent);
    color: var(--ds-on-accent);
    font-size: 0.875rem;
  }

  .sec p {
    margin-top: 0.875rem;
    color: var(--ds-ink-soft);
  }

  .bullets {
    margin-top: 0.875rem;
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--ds-ink-soft);
  }

  .bullets strong {
    color: var(--ds-ink);
  }
</style>
