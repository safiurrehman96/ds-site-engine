---
/**
 * Image + copy block. Roughly half of every page in the system (spec §08):
 * intro, trust, about, explainer, local, why-us and cross-sell all render here.
 *
 * Four compositions, selected by the preset's `splitStyle` motif and overridable
 * per page. Because this component repeats 2–4 times on every page, its layout
 * drives overall page rhythm more than any other.
 *
 * `imageSide` auto-alternates by index so recipes don't have to think about it
 * (spec §13 — variants should be earned, not fiddled with per page).
 *
 * A block with no image ignores the variant — there is no meaningful "beside" or
 * "overlap" without a second element — and picks one of two compositions of its own
 * instead, from the shape of its own copy:
 *
 *   centred — flowing prose, held to a reading measure and centred
 *   rail    — structured copy (a checklist or a run of labelled points): the heading
 *             moves into a narrow left column and the body takes the full remaining
 *             width, where Prose's grids have room to be two columns
 *
 * That choice is content-driven rather than positional because copy-only blocks
 * repeat: a JetSpa service page is four of them (intro, explainer, crossSell,
 * whyItMatters) and every one used to render as the same centred grey ribbon. Keying
 * off the body means adjacent sections differ exactly when their content differs.
 */
import type { Preset } from '../config-schema';
import Img from './Img.astro';
import Prose from './Prose.astro';
import { getPreset } from '../styles/presets';
import { activePreset } from '../lib/theme';
import { isStructuredProse } from '../lib/content';
import { siteConfig } from '../lib/site-config';

type SplitVariant = 'beside' | 'overlap' | 'wide' | 'stack';
type CopyLayout = 'centred' | 'rail';

interface Props {
  heading: string;
  body: string;
  image?: { src: string; alt: string };
  imageSide?: 'left' | 'right';
  /** Zero-based position in the page; drives auto-alternation. */
  index?: number;
  eyebrow?: string;
  cta?: { label: string; href: string };
  badge?: { image: string; alt: string; href?: string };
  tone?: 'paper' | 'card';
  /** Overrides the preset's composition. */
  variant?: SplitVariant;
  /**
   * Overrides the copy-only composition. `rail` also accepts an image, which then
   * renders inside the heading column rather than beside the copy.
   */
  layout?: CopyLayout;
  /** Render under a preset other than the configured one (styleguide only). */
  preset?: Preset;
}

const {
  heading,
  body,
  image,
  imageSide,
  index = 0,
  eyebrow,
  cta,
  badge,
  tone = 'paper',
  variant,
  layout,
  preset,
} = Astro.props;

const side = imageSide ?? (index % 2 === 0 ? 'right' : 'left');
const active: SplitVariant =
  variant ?? getPreset(preset ?? activePreset).motif.splitStyle;

const copyLayout: CopyLayout | undefined =
  layout ?? (image ? undefined : isStructuredProse(body) ? 'rail' : 'centred');

/**
 * The rail can carry a photo, and when it does the photo goes in the rail column
 * under the heading rather than beside the copy as a second grid child.
 *
 * Two things fall out of that. The rail column stops being empty below its heading —
 * on a long block that was several hundred pixels of dead space next to the copy it
 * was supposed to be labelling. And the body keeps the full remaining width, which
 * `beside` would have halved: a points grid or checklist needs ~32rem to go two
 * columns, and `beside`'s copy column lands right on that boundary.
 */
const railMedia = Boolean(image && copyLayout === 'rail');

/* A centred column sized for reading prose is too narrow for Prose's grids; flag
   structured copy so the centred composition can widen for it. */
const structured = isStructuredProse(body);
---

<section
  class="split ds-section"
  data-tone={tone}
  data-side={side}
  data-media={image && !railMedia ? 'yes' : 'no'}
  data-variant={image && !railMedia ? active : 'beside'}
  data-copy={copyLayout}
  data-structured={structured ? 'yes' : undefined}
>
  {/*
    The wide variant's media lives OUTSIDE .ds-container, as a direct child of the
    section, because it must span the full section while everything in the container
    cannot: base.css animates `transform` on every `.ds-section > .ds-container`
    (the scroll reveal), and a transform-animated element becomes the containing
    block for absolutely positioned descendants regardless of `position`. With the
    media inside, its `inset: 0` resolved against the 1180px container and the
    "full-bleed" band quietly clipped to content width. Outside, no amount of
    container styling can capture it.
  */}
  {
    image && !railMedia && active === 'wide' && (
      <div class="media">
        <Img
          src={image.src}
          alt={image.alt}
          widths={[480, 768, 1200, 1600]}
          sizes="100vw"
        />
      </div>
    )
  }

  <div class="ds-container grid">
    {/*
      Head and body are separate elements in every composition, not just the rail,
      so the two differ by CSS alone — the rail turns `.copy` into a grid and they
      become its columns, everywhere else they stack exactly as before.
    */}
    <div class="copy">
      <div class="copy-head">
        {eyebrow && <p class="ds-kicker">{eyebrow}</p>}
        <h2>{heading}</h2>

        {
          railMedia && image && (
            <div class="media rail-media">
              <Img
                src={image.src}
                alt={image.alt}
                widths={[320, 480, 768]}
                sizes="(min-width: 900px) 19rem, 100vw"
              />
            </div>
          )
        }
      </div>

      <div class="copy-body">
        <Prose body={body} class="body" />

        {
          badge && (
            <div class="badge">
              {badge.href ? (
                <a href={badge.href} target="_blank" rel="noopener noreferrer">
                  <Img src={badge.image} alt={badge.alt} widths={[160, 320]} sizes="160px" />
                </a>
              ) : (
                <Img src={badge.image} alt={badge.alt} widths={[160, 320]} sizes="160px" />
              )}
            </div>
          )
        }

        {
          cta && (
            <p class="cta">
              <a class="ds-btn ds-btn--primary" href={cta.href}>
                {cta.label}
              </a>
            </p>
          )
        }
      </div>
    </div>

    {
      image && !railMedia && active !== 'wide' && (
        <div class="media">
          <Img
            src={image.src}
            alt={image.alt}
            widths={[480, 768, 1200, 1600]}
            sizes="(min-width: 900px) 60vw, 100vw"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .split[data-tone='card'] {
    background: var(--ds-card);
  }

  .grid {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }

  .copy h2 {
    margin-top: 0.5rem;
  }

  .copy-body {
    margin-top: 1rem;
  }

  .copy :global(.body) {
    color: var(--ds-ink-soft);
    font-size: 1.0625rem;
  }

  .badge {
    margin-top: 1.5rem;
    max-width: 160px;
  }

  .cta {
    margin-top: 1.75rem;
  }

  .media :global(img) {
    width: 100%;
    object-fit: cover;
  }

  /* Rail media sits inside the head column, under the heading. It keeps the crop and
     surface treatment the beside rules already give a .media image. */
  .rail-media {
    margin-top: 1.5rem;
  }

  /*
   * The accent panel behind the photo is offset outward, so on a left-side block it
   * reaches 1.1rem past the photo's own left edge — past the heading's edge, right up
   * against the bar head motif's accent rule. Shifting the photo right by the same
   * amount puts the panel's edge where the heading's is, instead of in the gutter.
   *
   * Bounded below at 641px because that is where the panel stops being drawn.
   */
  @media (min-width: 641px) {
    .split[data-copy='rail'][data-side='left'] .rail-media {
      margin-left: 1.1rem;
    }
  }

  /* ========== copy-only: centred — flowing prose at a reading measure ========== */

  /*
   * width: 100% is load-bearing, not belt-and-braces. `margin-inline: auto`
   * suppresses a grid item's default stretch, leaving .copy shrink-to-fit — and
   * Prose declares `container-type: inline-size`, whose size containment makes the
   * prose contribute *nothing* to max-content. Without an explicit width the column
   * collapses to the width of its own <h2>, so a block headed "Who We Are" sets two
   * words per line while one headed "Built by Operators, Not Outsiders" looks fine.
   */
  .split[data-copy='centred'] .copy {
    width: 100%;
    max-width: 64ch;
    margin-inline: auto;
    text-align: center;
  }

  .split[data-copy='centred'] .cta,
  .split[data-copy='centred'] .badge {
    margin-inline: auto;
  }

  .split[data-copy='centred'] .copy :global(.ds-kicker) {
    justify-content: center;
  }

  /* Structured copy in the centred composition: the reading measure is too narrow
     for Prose's grids to go two-column, so the column widens — but the flowing
     paragraphs around the grids keep the measure, or their centred lines run long. */
  .split[data-copy='centred'][data-structured] .copy {
    max-width: 46rem;
  }

  .split[data-copy='centred'][data-structured] .copy-body :global(.ds-prose > p) {
    max-width: 62ch;
    margin-inline: auto;
  }

  /* ========== copy-only: rail — heading left, structured body right ========== */

  @media (min-width: 900px) {
    .split[data-copy='rail'] .copy {
      display: grid;
      /* minmax(0, …) on both tracks: without it a long unbroken word in either
         column blows the grid past the container instead of wrapping. */
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4.5rem);
      align-items: start;
    }

    /* The heading is the rail's only occupant, so the body starts level with it
       rather than a paragraph's gap below where the heading used to be. */
    .split[data-copy='rail'] .copy-body {
      margin-top: 0;
    }

    /* The h2 keeps its place in the type scale; the rail is sized to hold it. */
    .split[data-copy='rail'] .copy-head h2 {
      margin-top: 0;
    }

    /*
     * Sticky, so the heading follows its own copy instead of scrolling away and
     * leaving a blank column beside the block it labels. Works only because the rail
     * grid sets `align-items: start` — a stretched grid item fills the row and has no
     * room to move within it, so sticky silently does nothing.
     *
     * Offset clears the sticky site header (68px, Header.astro).
     */
    .split[data-copy='rail'] .copy-head {
      position: sticky;
      top: calc(68px + 2rem);
    }

    .split[data-copy='rail'] .rail-media {
      margin-top: 1.75rem;
    }

    /*
     * Paragraphs get a reading measure; the grids Prose builds do not, and keep the
     * full column. Without this a rail of flowing prose sets ~85ch lines, which is
     * well past where the eye loses the start of the next line — the reason the
     * centred composition capped at 64ch in the first place.
     */
    .split[data-copy='rail'] .copy-body :global(.ds-prose > p) {
      max-width: 66ch;
    }
  }

  /* ================= beside — image alongside the copy ================= */

  @media (min-width: 900px) {
    /* Slight asymmetry reads as designed; a dead-even 50/50 reads as a wireframe. */
    .split[data-variant='beside'][data-media='yes'] .grid {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .split[data-variant='beside'][data-side='left'] .copy {
      order: 2;
    }

    .split[data-variant='beside'][data-side='left'][data-media='yes'] .grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .split[data-variant='beside'] .media {
    position: relative;
  }

  /* Offset accent panel behind the photo — depth without extra payload assets. */
  .split[data-variant='beside'] .media::before {
    content: '';
    position: absolute;
    z-index: 0;
    border-radius: var(--ds-radius-lg);
    background: color-mix(in srgb, var(--ds-accent) 20%, transparent);
  }

  .split[data-variant='beside'][data-side='right'] .media::before {
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
  }

  .split[data-variant='beside'][data-side='left'] .media::before {
    inset: 1.1rem 1.1rem -1.1rem -1.1rem;
  }

  @media (max-width: 640px) {
    .split[data-variant='beside'] .media::before {
      display: none;
    }
  }

  .split[data-variant='beside'] .media :global(img) {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow-lg);
  }

  /* ================= overlap — copy on a card over the image ================= */

  .split[data-variant='overlap'] .grid {
    gap: 0;
  }

  .split[data-variant='overlap'] .media :global(img) {
    aspect-ratio: 16 / 10;
    border-radius: var(--ds-radius-lg);
  }

  .split[data-variant='overlap'] .copy {
    padding: clamp(1.5rem, 1.25rem + 1.5vw, 2.5rem);
    background: var(--ds-card);
    border: var(--ds-border);
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow-lg);
  }

  /* Stacked on small screens: the card rides up over the image's bottom edge. */
  @media (max-width: 899px) {
    .split[data-variant='overlap'] .copy {
      order: 2;
      margin: -2.5rem 0.75rem 0;
      z-index: 1;
      position: relative;
    }

    .split[data-variant='overlap'] .media {
      order: 1;
    }
  }

  @media (min-width: 900px) {
    .split[data-variant='overlap'] .grid {
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
    }

    .split[data-variant='overlap'] .media {
      grid-row: 1;
      grid-column: 1 / span 8;
    }

    .split[data-variant='overlap'] .copy {
      grid-row: 1;
      grid-column: 7 / span 6;
      z-index: 1;
    }

    .split[data-variant='overlap'][data-side='left'] .media {
      grid-column: 5 / span 8;
    }

    .split[data-variant='overlap'][data-side='left'] .copy {
      grid-column: 1 / span 6;
    }
  }

  /* ================= wide — full-bleed image band, copy over a scrim ============ */

  .split[data-variant='wide'] {
    position: relative;
    isolation: isolate;
    color: var(--ds-on-deep);
    background: var(--ds-deep);
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
  }

  /* Media is a direct child of the section (see the template comment), so the
     section is its containing block no matter what base.css does to the container —
     which stays `position: relative; z-index: 1` and keeps the copy above the band. */
  .split[data-variant='wide'] .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .split[data-variant='wide'] .copy {
    position: relative;
    z-index: 1;
  }

  .split[data-variant='wide'] .media :global(img) {
    height: 100%;
  }

  /* Copy sits in a column, so a horizontal scrim earns its place here. */
  .split[data-variant='wide'] .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ds-deep) 62%, transparent) 0%,
      color-mix(in srgb, var(--ds-deep) 80%, transparent) 100%
    );
  }

  @media (min-width: 900px) {
    .split[data-variant='wide'] .media::after {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--ds-deep) 52%, transparent) 0%,
          color-mix(in srgb, var(--ds-deep) 74%, transparent) 100%
        ),
        linear-gradient(90deg, color-mix(in srgb, var(--ds-deep) 60%, transparent) 0%, transparent 65%);
    }

    .split[data-variant='wide'][data-side='left'] .media::after {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--ds-deep) 52%, transparent) 0%,
          color-mix(in srgb, var(--ds-deep) 74%, transparent) 100%
        ),
        linear-gradient(270deg, color-mix(in srgb, var(--ds-deep) 60%, transparent) 0%, transparent 65%);
    }
  }

  .split[data-variant='wide'] .copy {
    max-width: 46rem;
  }

  .split[data-variant='wide'][data-side='left'] .copy {
    margin-left: auto;
    text-align: right;
  }

  .split[data-variant='wide'][data-side='left'] .copy :global(.ds-kicker) {
    justify-content: flex-end;
  }

  .split[data-variant='wide'] .copy :global(.body) {
    color: var(--ds-on-deep);
    opacity: 0.92;
  }

  /* ================= stack — image above, copy centred beneath ================= */

  .split[data-variant='stack'] .grid {
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .split[data-variant='stack'] .media {
    order: 1;
  }

  /* width: 100% for the same reason as the centred composition above. */
  .split[data-variant='stack'] .copy {
    order: 2;
    width: 100%;
    max-width: 64ch;
    margin-inline: auto;
    text-align: center;
  }

  .split[data-variant='stack'] .copy :global(.ds-kicker) {
    justify-content: center;
  }

  .split[data-variant='stack'] .cta,
  .split[data-variant='stack'] .badge {
    margin-inline: auto;
  }

  .split[data-variant='stack'] .media :global(img) {
    aspect-ratio: 21 / 9;
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow-lg);
  }
</style>
