---
/**
 * Nav shell. Services and Areas dropdowns are built from the collections, so
 * adding a markdown file adds a nav entry.
 *
 * Zero client JS: both dropdowns and the mobile menu are native <details>
 * elements (guardrail — prefer native HTML over JS).
 */
import Img from './Img.astro';
import { getServices, getAreas, areaLabel } from '../lib/content';
import { siteConfig } from '../../client/site.config';

const [services, areas] = await Promise.all([getServices(), getAreas()]);
const { brand, contact, modules } = siteConfig;

const serviceLinks = services.map((s) => ({ href: `/${s.data.slug}`, label: s.data.name }));
const areaLinks = areas.map((a) => ({
  href: `/${a.data.slug}`,
  // shortName wins in nav where it exists — long area names ("Teterboro Airport
  // (KTEB)") wrap the dropdown. Kleen sets none, so the label is unchanged.
  label: a.data.isHeadquarters ? `${a.data.name} HQ` : (a.data.shortName ?? areaLabel(a.data)),
}));
---

<header class="header">
  <div class="ds-container inner">
    <a class="brand" href="/" aria-label={`${brand.name} — home`}>
      <Img
        src={brand.logoPath}
        alt={`${brand.name} logo`}
        widths={[200, 400]}
        sizes="200px"
        loading="eager"
        class="brand-logo"
      />
    </a>

    {/*
      Two nav instances rather than one responsive element.

      A closed <details> hides its children no matter what `display` is set on it,
      so a single disclosure cannot be re-shown as a desktop bar with CSS alone.
      The alternatives were a checkbox hack (worse semantics) or client JS. Rendering
      both from the same link arrays keeps zero JS and costs only duplicate markup.
    */}

    <nav class="nav nav--desktop" aria-label="Primary">
      <ul class="nav-list">
        <li><a href="/">Home</a></li>
        <li>
          <details class="drop">
            <summary>Services</summary>
            <ul class="drop-list">
              {serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li>
          <details class="drop">
            <summary>Coverage Areas</summary>
            <ul class="drop-list">
              {areaLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/about">About</a></li>
        <li><a href="/faqs">FAQs</a></li>
        {modules.blogUrl && <li><a href={modules.blogUrl}>Blog</a></li>}
        <li><a href="/get-quote">Contact</a></li>
      </ul>

      <div class="nav-cta">
        <a class="ds-btn ds-btn--secondary phone-cta" href={`tel:${contact.phone}`}>
          {contact.phoneDisplay}
        </a>
        <a class="ds-btn ds-btn--primary" href="/booking">Book Today</a>
      </div>
    </nav>

    <details class="menu">
      <summary aria-label="Toggle navigation menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>

      <nav class="nav nav--mobile" aria-label="Primary, mobile">
        <ul class="nav-list">
          <li><a href="/">Home</a></li>
          <li>
            <details class="drop">
              <summary>Services</summary>
              <ul class="drop-list">
                {serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </details>
          </li>
          <li>
            <details class="drop">
              <summary>Coverage Areas</summary>
              <ul class="drop-list">
                {areaLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </details>
          </li>
          <li><a href="/about">About</a></li>
          <li><a href="/faqs">FAQs</a></li>
          {modules.blogUrl && <li><a href={modules.blogUrl}>Blog</a></li>}
          <li><a href="/get-quote">Contact</a></li>
        </ul>

        <div class="nav-cta">
          <a class="ds-btn ds-btn--secondary" href={`tel:${contact.phone}`}>
            {contact.phoneDisplay}
          </a>
          <a class="ds-btn ds-btn--primary" href="/booking">Book Today</a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ds-card);
    border-bottom: 1px solid var(--ds-line);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .brand :global(.brand-logo) {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 1024px) {
    .brand :global(.brand-logo) {
      height: 46px;
    }
  }

  /* ---------- shared link styling ---------- */

  .nav-list a,
  .drop > summary {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--ds-radius-sm);
    font-family: var(--ds-font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-list a:hover,
  .drop > summary:hover {
    color: var(--ds-accent);
    background: color-mix(in srgb, var(--ds-accent) 8%, transparent);
  }

  .drop > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .drop > summary::-webkit-details-marker {
    display: none;
  }

  .drop > summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .drop[open] > summary::after {
    transform: translateY(1px) rotate(-135deg);
  }

  .drop-list a {
    white-space: nowrap;
  }

  /* ---------- mobile (default) ---------- */

  .nav--desktop {
    display: none;
  }

  .menu > summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 1px solid var(--ds-line);
    border-radius: var(--ds-radius-sm);
    cursor: pointer;
  }

  .menu > summary::-webkit-details-marker {
    display: none;
  }

  .bars {
    display: grid;
    gap: 4px;
  }

  .bars i {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .nav {
    position: absolute;
    left: 0;
    right: 0;
    background: var(--ds-card);
    border-bottom: 1px solid var(--ds-line);
    box-shadow: var(--ds-shadow-lg);
    padding: 0.75rem clamp(1rem, 0.5rem + 2vw, 2.5rem) 1.25rem;
    max-height: calc(100dvh - 68px);
    overflow-y: auto;
  }

  .drop-list {
    padding-left: 0.75rem;
    border-left: 2px solid var(--ds-line);
    margin: 0.25rem 0 0.5rem 0.75rem;
  }

  .nav-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .nav-cta .ds-btn {
    flex: 1 1 auto;
  }

  /* ---------- desktop ---------- */

  @media (min-width: 1024px) {
    .menu {
      display: none;
    }

    .nav--desktop {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: static;
      box-shadow: none;
      border: 0;
      padding: 0;
      overflow: visible;
      max-height: none;
      background: none;
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: 0.125rem;
    }

    .drop {
      position: relative;
    }

    .drop-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      min-width: 14rem;
      padding: 0.5rem;
      margin: 0;
      border: 1px solid var(--ds-line);
      border-radius: var(--ds-radius-md);
      background: var(--ds-card);
      box-shadow: var(--ds-shadow-lg);
    }

    .nav-cta {
      margin-top: 0;
      flex-wrap: nowrap;
    }
  }

  /* The phone button duplicates the TopBar number; only show it once there is room. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav--desktop .phone-cta {
      display: none;
    }
  }
</style>
