---
import { getGetQuote } from '../lib/content';
import { siteConfig } from '../lib/site-config';
import AviationEditorialQuote from '../templates/aviation-editorial/pages/QuotePage.astro';

const entry = await getGetQuote();

if (siteConfig.template !== 'aviation-editorial') {
  throw new Error(`No quote page registered for template "${siteConfig.template}".`);
}
---

<AviationEditorialQuote {entry} />
