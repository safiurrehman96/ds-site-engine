---
/**
 * Recipe D — Get a Quote. Links out to the GHL form (core principle 6: the
 * engine never rebuilds booking or quote forms).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Inline from '../components/Inline.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CTABanner from '../components/CTABanner.astro';
import GHLEmbed from '../components/GHLEmbed.astro';
import { getServices, getGetQuote } from '../lib/content';
import { siteConfig } from '../lib/site-config';

const services = await getServices();
const page = (await getGetQuote()).data;
const { contact, hours, ghl, serviceArea } = siteConfig;
---

<BaseLayout title={page.title} description={page.metaDescription} path="/get-quote">
  <section class="quote ds-section">
    <div class="ds-container grid">
      <div class="copy">
        <h1>{page.heroHeadline}</h1>
        <p class="ds-lede"><Inline text={page.heroIntro} /></p>

        {
          ghl.embed ? (
            <GHLEmbed src={ghl.quoteUrl} title={page.heroHeadline} />
          ) : (
            <p class="btns">
              <a
                class="ds-btn ds-btn--primary"
                href={ghl.quoteUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Request Your Quote
              </a>
              <a class="ds-btn ds-btn--secondary" href={`tel:${contact.phone}`}>
                Call {contact.phoneDisplay}
              </a>
            </p>
          )
        }

        <h2 class="sub">{page.servicesHeading}</h2>
        <ul class="services">
          {services.map((s) => <li><a href={`/${s.data.slug}`}>{s.data.name}</a></li>)}
        </ul>
      </div>

      <aside class="panel">
        <h2>{page.panelHeading}</h2>

        <dl class="details">
          <dt>Phone</dt>
          <dd><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          <dt>Coverage</dt>
          <dd>{serviceArea.radiusMiles}-mile radius across {serviceArea.label}</dd>
        </dl>

        <h3>Working Hours</h3>
        <ul class="hours">
          {hours.map((h) => <li><span>{h.days}</span><span>{h.hours}</span></li>)}
        </ul>

        <h3>Follow Us</h3>
        <SocialLinks />
      </aside>
    </div>
  </section>

  <CTABanner headline={page.ctaHeadline} />
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .copy .ds-lede {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .sub {
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }

  .services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .services a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: var(--ds-border);
    border-radius: var(--ds-radius-pill);
    background: var(--ds-card);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .services a:hover {
    border-color: var(--ds-accent);
    color: var(--ds-accent);
  }

  .panel {
    padding: 1.75rem;
    background: var(--ds-card);
    border: var(--ds-border);
    border-radius: var(--ds-radius-lg);
    box-shadow: var(--ds-shadow);
  }

  .panel h2 {
    font-size: 1.25rem;
  }

  .panel h3 {
    margin-top: 1.75rem;
    font-size: 1rem;
  }

  .details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }

  .details dt {
    font-weight: 600;
  }

  .details dd {
    color: var(--ds-ink-soft);
  }

  .hours {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--ds-ink-soft);
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hours span:first-child {
    color: var(--ds-ink);
    font-weight: 500;
  }
</style>
