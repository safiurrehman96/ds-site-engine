---
import type { InferGetStaticPropsType } from 'astro';
import { getAreas } from '../lib/content';
import { siteConfig } from '../lib/site-config';
import AviationEditorialAirport from '../templates/aviation-editorial/pages/AirportPage.astro';

export const getStaticPaths = async () => {
  const areas = await getAreas();
  return areas.map((entry) => ({
    params: { area: entry.data.slug },
    props: { entry },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;

if (siteConfig.template !== 'aviation-editorial' || !entry.data.airport) {
  throw new Error(`No airport page registered for template "${siteConfig.template}".`);
}
---

<AviationEditorialAirport {entry} />
