---
/**
 * Recipe C — Location page. One per client/content/areas/*.md.
 *
 * Hero → localCopy → localDetail? → ServicesGrid → BeforeAfter? → SocialStrip →
 * whyUs → CTABanner
 *
 * The three content blocks go through composeBlocks() rather than being rendered as
 * three identical SplitSections. They used to be exactly that, and localCopy and
 * localDetail sit back to back — two centred columns of the same width and rhythm,
 * on every area page a client has.
 */
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import SocialStrip from '../components/SocialStrip.astro';
import CTABanner from '../components/CTABanner.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { getAreas, areaLabel } from '../lib/content';
import { composeBlocks } from '../lib/compose';
import { buildTitle, buildH1 } from '../lib/seo';
import { siteConfig } from '../lib/site-config';

// Deliberately unannotated — see [service].astro.
export const getStaticPaths = async () => {
  const areas = await getAreas();
  return areas.map((entry) => ({
    params: { area: entry.data.slug },
    props: { entry },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const a = entry.data;
const { seo, defaults } = siteConfig;

// Authored strings win; the formula is the fallback for payloads that supply neither.
const title = a.title ?? buildTitle(siteConfig, seo.category, a.name, a.state);
const h1 = a.h1 ?? buildH1(seo.category, a.name, a.state);

/**
 * Composed as one run even though ServicesGrid and SocialStrip land between them:
 * the photo rotation, the one-callout-per-page limit and the adjacency pass are all
 * page-level rules, and slicing after the fact keeps them that way.
 *
 * whyUs closes on a quote CTA whether or not the payload supplied one — it is the
 * page's last word before the banner, and that has always been its job here.
 */
const leadingBlocks = [a.localCopy, a.localDetail].filter((b) => b !== undefined);
const composed = composeBlocks(
  [...leadingBlocks, { ...a.whyUs, cta: a.whyUs.cta ?? { label: 'Get A Quote', href: '/get-quote' } }],
  {
    /*
     * Overlap leads here, where About leads with beside. The first block sits
     * directly under a full-bleed video hero, and overlap's solid copy card is the
     * one photo composition that answers a moving background with a calm reading
     * surface rather than a second image band — `wide` would stack two full-bleed
     * bands. It also gives area pages a signature About does not repeat.
     */
    photoVariants: ['overlap', 'beside', 'stack'],
  },
);

const leading = composed.slice(0, leadingBlocks.length);
const trailing = composed.slice(leadingBlocks.length);
---

<BaseLayout
  title={title}
  description={a.metaDescription}
  path={`/${a.slug}`}
  ogImage={defaults.heroVideo.poster.src}
>
  <Hero heading={h1} body={a.heroIntro} />

  <ContentBlocks entries={leading} />

  {/*
    Tiles, as on About. An area page is already a wall of words about one location —
    the nine service descriptions repeated verbatim under every area added nothing a
    visitor had not read on home, and they are one click away on the service pages
    themselves. The per-area `servicesIntro` still carries the local framing.
  */}
  <ServicesGrid
    variant="tiles"
    tone="card"
    heading={`Services Available in ${areaLabel(a)}`}
    intro={a.servicesIntro}
  />

  {
    a.beforeAfter && (
      <BeforeAfter {...a.beforeAfter} heading={`Recent Work in ${a.name}`} tone="card" />
    )
  }

  <SocialStrip image={defaults.socialImage} />

  <ContentBlocks entries={trailing} />

  <CTABanner headline={a.ctaHeadline} />
</BaseLayout>
