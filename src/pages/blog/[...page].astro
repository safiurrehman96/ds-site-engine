---
/**
 * Recipe H — Blog index. Hero → post card grid → CTABanner.
 *
 * A rest route rather than a static index.astro so the page is conditional: with
 * zero published posts getStaticPaths returns nothing and /blog does not exist,
 * instead of shipping an empty archive. paginate() gives /blog, /blog/2, … for free
 * once a client's archive outgrows one page.
 *
 * Engine-only copy, like the 404: an index page's words are navigation, not
 * marketing, so every line derives from config and no payload authors it.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTABanner from '../../components/CTABanner.astro';
import Img from '../../components/Img.astro';
import { getPosts } from '../../lib/content';
import { siteConfig } from '../../lib/site-config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  if (posts.length === 0) return [];
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { brand, seo, defaults } = siteConfig;

const title = `Blog | ${brand.name}`;
const description = `${seo.category} tips, guides, and news from ${brand.name}, serving ${siteConfig.serviceArea.label}.`;

const dateLabel = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={page.currentPage > 1 ? `Blog — Page ${page.currentPage} | ${brand.name}` : title}
  description={description}
  path={page.currentPage > 1 ? `/blog/${page.currentPage}` : '/blog'}
>
  <Hero heading={`${seo.category} Tips & Advice`} body={description} proof={false} />

  <section class="ds-section">
    <div class="ds-container">
      <ul class="post-grid">
        {
          page.data.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.data.slug}/`}>
                <div class="post-media">
                  <Img
                    src={(post.data.heroImage ?? defaults.socialImage).src}
                    alt={post.data.heroImage?.alt ?? ''}
                    widths={[480, 768]}
                    sizes="(min-width: 760px) 33vw, 100vw"
                  />
                </div>
                <div class="post-copy">
                  <p class="post-date">{dateLabel(post.data.publishDate)}</p>
                  <h2>{post.data.title}</h2>
                  <p class="post-excerpt">{post.data.metaDescription}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      {
        page.lastPage > 1 && (
          <nav class="pager" aria-label="Blog pages">
            {page.url.prev && <a class="ds-btn ds-btn--secondary" href={page.url.prev}>Newer posts</a>}
            <span class="pager-status">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next && <a class="ds-btn ds-btn--secondary" href={page.url.next}>Older posts</a>}
          </nav>
        )
      }
    </div>
  </section>

  <CTABanner headline={defaults.ctaHeadline} />
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 760px) {
    .post-grid {
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    }
  }

  .post-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--ds-card);
    border: var(--ds-border);
    border-radius: var(--ds-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .post-card a:hover {
    box-shadow: var(--ds-shadow-lg);
    transform: translateY(-2px);
  }

  .post-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .post-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .post-date {
    font-family: var(--ds-font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ds-accent-ink);
  }

  .post-copy h2 {
    font-size: 1.25rem;
  }

  .post-card a:hover h2 {
    color: var(--ds-accent-ink);
  }

  .post-excerpt {
    color: var(--ds-ink-soft);
    font-size: 0.9375rem;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pager-status {
    font-size: 0.875rem;
    color: var(--ds-ink-soft);
  }
</style>
