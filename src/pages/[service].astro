---
import type { InferGetStaticPropsType } from 'astro';
import { getServices } from '../lib/content';
import { siteConfig } from '../lib/site-config';
import AviationEditorialService from '../templates/aviation-editorial/pages/ServicePage.astro';

// Deliberately unannotated: adding `: GetStaticPaths` widens the return type and
// collapses InferGetStaticPropsType to `never`.
export const getStaticPaths = async () => {
  const services = await getServices();
  return services.map((entry) => ({
    params: { service: entry.data.slug },
    props: { entry },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;

if (siteConfig.template !== 'aviation-editorial') {
  throw new Error(`No service page registered for template "${siteConfig.template}".`);
}
---

<AviationEditorialService {entry} />
