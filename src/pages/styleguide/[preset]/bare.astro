---
/**
 * /styleguide/{preset}/bare — same content, switcher suppressed. Exists purely so
 * /styleguide/compare can embed each preset in an iframe without four sticky
 * switcher bars.
 *
 * A dedicated route rather than a `?bare` query param: query strings are not
 * available at build time in a static build, so the param silently did nothing.
 */
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StyleguideContent from '../../../components/StyleguideContent.astro';
import { ALL_PRESETS } from '../../../styles/presets';
import { siteConfig } from '../../../../client/site.config';

export const getStaticPaths = async () =>
  ALL_PRESETS.map((preset) => ({ params: { preset }, props: { preset } }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { preset } = Astro.props as Props;
const { brand } = siteConfig;
---

<BaseLayout
  title={`Styleguide · ${preset} (embedded) — ${brand.name}`}
  description="Internal component reference. Not indexed."
  path={`/styleguide/${preset}/bare`}
  noindex={true}
  preset={preset}
>
  <StyleguideContent preset={preset} bare={true} />
</BaseLayout>
