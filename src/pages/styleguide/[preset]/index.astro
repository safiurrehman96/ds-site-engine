---
/**
 * /styleguide/{preset} — the full component set under a preset other than the
 * configured one, without touching client/site.config.ts.
 *
 * BaseLayout takes an optional preset override, so each route emits that preset's
 * tokens and motifs. This is what makes comparison possible.
 */
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StyleguideContent from '../../../components/StyleguideContent.astro';
import { ALL_PRESETS } from '../../../styles/presets';
import { siteConfig } from '../../../../client/site.config';

// Unannotated so InferGetStaticPropsType resolves — see [service].astro.
export const getStaticPaths = async () =>
  ALL_PRESETS.map((preset) => ({ params: { preset }, props: { preset } }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { preset } = Astro.props as Props;
const { brand } = siteConfig;
---

<BaseLayout
  title={`Styleguide · ${preset} — ${brand.name}`}
  description="Internal component reference. Not indexed."
  path={`/styleguide/${preset}`}
  noindex={true}
  preset={preset}
>
  <StyleguideContent preset={preset} />
</BaseLayout>
