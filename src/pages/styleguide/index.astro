---
/**
 * /styleguide — every component under the *configured* preset.
 * Noindexed, and excluded from the sitemap in astro.config.mjs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StyleguideContent from '../../components/StyleguideContent.astro';
import { siteConfig } from '../../lib/site-config';
import { activePreset } from '../../lib/theme';

const { theme, brand } = siteConfig;
---

<BaseLayout
  title={`Styleguide — ${brand.name}`}
  description="Internal component reference. Not indexed."
  path="/styleguide"
  noindex={true}
>
  <StyleguideContent preset={activePreset} />
</BaseLayout>
