---
/**
 * The page shell every recipe renders into. Owns the token block, GTM, and the
 * global shell components — recipes only supply <slot> content and SEO props.
 */
import SEOHead from '../components/SEOHead.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Preset } from '../config-schema';
import { tokensToCss, presetAttrs, assertAccentContrast } from '../styles/presets';
import { activePreset } from '../lib/theme';
import { localBusinessJsonLd } from '../lib/seo';
import { getAreas } from '../lib/content';
import { siteConfig } from '../lib/site-config';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** Page-specific graphs. LocalBusiness is added here for every page. */
  jsonLd?: Array<Record<string, unknown>>;
  /**
   * Render under a preset other than the configured one. Only /styleguide uses
   * this — client pages always use theme.preset.
   */
  preset?: Preset;
}

const {
  title,
  description,
  path,
  ogImage,
  noindex = false,
  jsonLd = [],
  preset: presetOverride,
} = Astro.props;

const { theme, tracking } = siteConfig;
const preset = presetOverride ?? activePreset;

// Fails the build if the chosen accent cannot meet WCAG AA on this preset.
assertAccentContrast(preset, theme.accentColor);

const tokens = tokensToCss(preset, theme.accentColor);
const attrs = presetAttrs(preset);

const areas = await getAreas();
const graphs = [
  localBusinessJsonLd(
    siteConfig,
    areas.map((a) => ({ name: a.data.name, state: a.data.state })),
  ),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={graphs}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Body face paints all copy and is the largest font file; preload it. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    <style set:html={tokens}></style>

    <!-- Google Tag Manager -->
    <script
      is:inline
      set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${tracking.gtmId}');`}
    />
  </head>

  <body {...attrs}>
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${tracking.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    <a class="ds-skip-link" href="#main">Skip to content</a>

    <TopBar />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
