---
import type { AviationHome } from '../schema';
import MediaSlot from './MediaSlot.astro';

interface Props {
  introduction: AviationHome['introduction'];
  mediaBand: AviationHome['mediaBand'];
}

const { introduction, mediaBand } = Astro.props;
---

<section class="introduction">
  <div class="intro-grid ae-container">
    <aside>
      <p>{introduction.eyebrow}</p>
      <i></i>
      <div>{introduction.metadata.map((item) => <span>{item}</span>)}</div>
    </aside>

    <div class="copy">
      <h2>{introduction.heading}</h2>
      <div class="body">{introduction.body.map((paragraph) => <p>{paragraph}</p>)}</div>
      <div class="stats">
        {introduction.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    </div>

    <div class="media-column">
      <MediaSlot {...introduction.primaryMedia} class="primary" sizes="(min-width: 64rem) 27vw, 100vw" />
      {introduction.detailMedia.length > 0 && (
        <div class="details">
          {introduction.detailMedia.map((media) => <MediaSlot {...media} class="detail" sizes="14vw" />)}
        </div>
      )}
    </div>
  </div>
</section>

<div class="media-band">
  {mediaBand.map((media, index) => (
    <MediaSlot {...media} class:list={['band-media', index === 0 && 'band-media--lead']} sizes={index === 0 ? '62vw' : '38vw'} />
  ))}
</div>

<style>
  .introduction {
    padding-block: clamp(4.5rem, 7.6vw, 6.9rem);
    background: var(--ae-bone);
    color: var(--ae-paper-ink);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr) minmax(18rem, 23.75rem);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  aside {
    padding-top: 0.55rem;
    color: #6c6a66;
    font-family: var(--ae-mono);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  aside p {
    color: #6b4f28;
    letter-spacing: 0.2em;
  }

  aside i {
    display: block;
    height: 1px;
    margin: 1.75rem 0 1rem;
    background: rgba(21, 23, 26, 0.18);
  }

  aside span {
    display: block;
  }

  h2 {
    max-width: 44rem;
    font-size: clamp(2.2rem, 3vw, 2.65rem);
    font-weight: 500;
    letter-spacing: -0.024em;
    line-height: 1.14;
    text-wrap: balance;
  }

  .body {
    display: grid;
    max-width: 44rem;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 2.75rem;
  }

  .body p {
    color: var(--ae-paper-copy);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3.25rem;
    border-top: 1px solid rgba(21, 23, 26, 0.16);
  }

  .stats div {
    padding: 1.35rem 1.8rem 0;
    border-right: 1px solid rgba(21, 23, 26, 0.12);
  }

  .stats div:first-child {
    padding-left: 0;
  }

  .stats div:last-child {
    border-right: 0;
  }

  .stats strong,
  .stats span {
    display: block;
    font-family: var(--ae-mono);
  }

  .stats strong {
    font-size: 2.1rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .stats span {
    margin-top: 0.5rem;
    color: #5d5b57;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .media-column {
    display: grid;
    gap: 1.5rem;
  }

  .media-column :global(.primary) {
    height: 21.25rem;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .details :global(.detail) {
    min-height: 9.4rem;
  }

  .media-band {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1px;
    border-top: 1px solid var(--ae-line);
    background: var(--ae-line);
  }

  .media-band :global(.band-media) {
    height: 21.25rem;
    border: 0;
  }

  @media (max-width: 68rem) {
    .intro-grid {
      grid-template-columns: 10rem 1fr;
    }

    .media-column {
      grid-column: 2;
      grid-template-columns: 1.3fr 1fr;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    .introduction {
      padding-block: 2rem;
    }

    .intro-grid {
      display: block;
    }

    aside i,
    aside div,
    .media-column,
    .media-band {
      display: none;
    }

    h2 {
      margin-top: 0.85rem;
      font-size: 1.6rem;
    }

    .body {
      display: block;
      margin-top: 0.9rem;
    }

    .body p {
      font-size: 0.92rem;
    }

    .body p + p {
      display: none;
    }

    .stats {
      margin-top: 1.4rem;
    }

    .stats div {
      padding: 0.9rem 0 0 0.75rem;
    }

    .stats div:first-child {
      padding-left: 0;
    }

    .stats strong {
      font-size: 1.25rem;
    }

    .stats span {
      font-size: 0.58rem;
    }
  }
</style>
