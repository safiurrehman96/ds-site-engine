---
import type { CollectionEntry } from 'astro:content';
import type { AviationAbout } from '../schema';
import MediaSlot from './MediaSlot.astro';
import SectionLabel from './SectionLabel.astro';

interface Props {
  content: AviationAbout['coverage'];
  areas: CollectionEntry<'areas'>[];
}

const { content, areas } = Astro.props;
const bySlug = new Map(areas.map((area) => [area.data.slug, area]));
const rows = content.airports.map((item) => {
  const area = bySlug.get(item.slug);
  if (!area) throw new Error(`About page references missing airport "${item.slug}".`);
  return { ...item, area };
});
---

<section class="coverage ae-section">
  <div class="grid ae-container">
    <div class="intro">
      <SectionLabel>{content.eyebrow}</SectionLabel>
      <h2>{content.heading}</h2>
      <p>{content.intro}</p>
      <div class="emergency"><h3>{content.emergencyLabel}</h3><p>{content.emergencyBody}</p></div>
    </div>

    <div class="locations">
      {rows.map(({ area, ...row }) => (
        <a href={`/${area.data.slug}`}>
          <strong>{area.data.shortName}</strong>
          <span><b>{area.data.name.replace(/\s*\([^)]*\)$/, '')}</b><small>{row.description}</small></span>
          <span class="status" data-status={row.status}><i></i>{row.status === 'badged' ? 'Badge access' : 'Escorted'}</span>
        </a>
      ))}
      <MediaSlot {...content.map} class="coverage-map" sizes="60vw" />
    </div>
  </div>
</section>

<style>
  .coverage {
    background: var(--ae-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(19rem, 26.25rem) 1fr;
    gap: clamp(3rem, 5.5vw, 5rem);
    align-items: start;
  }

  h2 {
    margin-top: 1.35rem;
    font-size: clamp(2.15rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.024em;
    line-height: 1.12;
  }

  .intro > p {
    margin-top: 1.25rem;
    color: var(--ae-muted);
    line-height: 1.7;
  }

  .emergency {
    margin-top: 1.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--ae-line);
  }

  .emergency h3 {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .emergency p {
    margin-top: 0.7rem;
    color: var(--ae-copy);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .locations {
    border-top: 1px solid var(--ae-line);
  }

  .locations > a {
    display: grid;
    min-height: 6.1rem;
    grid-template-columns: 10.6rem 1fr 12.5rem;
    align-items: center;
    gap: 1.75rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--ae-line-soft);
  }

  .locations > a:hover {
    background: var(--ae-panel);
  }

  .locations strong {
    font-family: var(--ae-mono);
    font-size: 2.35rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .locations b,
  .locations small {
    display: block;
  }

  .locations b {
    font-size: 1.18rem;
    font-weight: 500;
  }

  .locations small {
    margin-top: 0.2rem;
    color: var(--ae-muted);
    font-size: 0.84rem;
  }

  .status {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.55rem;
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .status i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--ae-accent);
  }

  .status[data-status='escorted'] {
    color: var(--ae-muted);
  }

  .status[data-status='escorted'] i {
    border: 1px solid var(--ae-muted);
    background: transparent;
  }

  .locations :global(.coverage-map) {
    height: 14.4rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 19rem 1fr;
      gap: 2.5rem;
    }

    .locations > a {
      grid-template-columns: 7rem 1fr 7rem;
      gap: 1rem;
    }
  }

  @media (max-width: 47.99rem) {
    .coverage {
      padding-block: 1.75rem;
    }

    .grid {
      display: block;
    }

    h2 {
      margin-top: 0.75rem;
      font-size: 1.5rem;
    }

    .intro > p {
      display: none;
    }

    .locations {
      margin-top: 1rem;
    }

    .locations > a {
      grid-template-columns: 1fr auto;
      gap: 0.4rem;
      padding: 0.65rem 0;
    }

    .locations strong {
      font-size: 1.3rem;
    }

    .locations > a > span:not(.status) {
      grid-column: 1;
    }

    .locations b {
      display: none;
    }

    .locations small {
      font-size: 0.78rem;
    }

    .status {
      grid-row: 1 / span 2;
      grid-column: 2;
      font-size: 0.6rem;
    }

    .locations :global(.coverage-map) {
      display: none;
    }

    .emergency {
      margin-top: 1rem;
      padding: 0.9rem 1rem;
    }

    .emergency p {
      font-size: 0.85rem;
    }
  }
</style>
