---
import type { CollectionEntry } from 'astro:content';
import Img from '../../../components/Img.astro';
import { siteConfig } from '../../../lib/site-config';

interface Props {
  services: CollectionEntry<'services'>[];
  areas: CollectionEntry<'areas'>[];
}

const { services, areas } = Astro.props;
const { brand, contact, socials } = siteConfig;
const footerServiceSlugs = new Set([
  'aircraft-exterior-detailing',
  'aircraft-interior-detailing',
  'aircraft-ceramic-coating',
  'brightwork-polishing',
  'de-ice-boot-refurbishment',
  'aog-emergency-cleaning',
]);
const footerServices = services.filter((service) => footerServiceSlugs.has(service.data.slug));
---

<footer>
  <div class="footer-grid">
    <div class="brand-column">
      <a class="brand" href="/" aria-label={`${brand.name} home`}>
        <Img src={brand.logoPath} alt={brand.name} widths={[160, 320]} sizes="160px" />
      </a>
      <p>{brand.tagline} Aircraft is what we do, and it is all we do.</p>
      {brand.footerNote && <strong>{brand.footerNote}</strong>}
    </div>

    <div>
      <h2>Services</h2>
      <nav aria-label="Footer services">
        {footerServices.map((service) => <a href={`/${service.data.slug}`}>{service.data.name}</a>)}
      </nav>
    </div>

    <div>
      <h2>Airports</h2>
      <nav aria-label="Footer airports">
        {areas.map((area) => <a href={`/${area.data.slug}`}>{area.data.shortName} — {area.data.name.replace(/\s*\([^)]*\)$/, '')}</a>)}
        <a href="/get-quote">Coverage requests</a>
      </nav>
    </div>

    <div>
      <h2>Company</h2>
      <nav aria-label="Footer company">
        <a href="/about">About</a>
        <a href="/#process">Process</a>
        <a href="/faqs">FAQs</a>
        <a href="/about#credentials">Insurance & certifications</a>
        {socials.instagram && <a href={socials.instagram}>Instagram</a>}
      </nav>
      <address>
        {contact.address.street}<br />
        {contact.address.city}, {contact.address.state} {contact.address.zip}<br />
        <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
      </address>
    </div>
  </div>

  <div class="legal-row">
    <span>© {new Date().getFullYear()} {brand.name} LLC · All rights reserved</span>
    <nav aria-label="Legal">
      <a href="/privacy-policy">Privacy</a>
      <a href="/tos">Terms</a>
      <a href="/about#credentials">Insurance certificates</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: 4rem var(--ae-gutter) 1.75rem;
    border-top: 1px solid var(--ae-line);
    background: var(--ae-deck);
  }

  .footer-grid {
    display: grid;
    max-width: 90rem;
    margin-inline: auto;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .brand {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  /* Matches the header's resting logo height exactly. */
  .brand :global(img) {
    width: auto;
    height: 3.75rem;
  }

  .brand-column p {
    max-width: 18rem;
    margin-top: 1.25rem;
    color: var(--ae-muted);
    font-size: 0.92rem;
  }

  .brand-column strong {
    display: block;
    margin-top: 1.5rem;
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    color: var(--ae-faint);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  footer nav {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.1rem;
  }

  footer nav a {
    color: var(--ae-copy);
    font-size: 0.9rem;
  }

  footer nav a:hover,
  address a:hover {
    color: #fff;
  }

  address {
    margin-top: 1.4rem;
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    font-style: normal;
    line-height: 1.8;
  }

  address a {
    color: var(--ae-bone);
  }

  .legal-row {
    display: flex;
    max-width: 90rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 3.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ae-line-soft);
    color: var(--ae-faint);
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .legal-row nav {
    flex-direction: row;
    gap: 1.75rem;
    margin: 0;
  }

  .legal-row nav a {
    color: var(--ae-faint);
    font-size: inherit;
  }

  @media (max-width: 62rem) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer-grid > :last-child {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    footer {
      padding-top: 2rem;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.25rem;
    }

    .brand-column {
      grid-column: 1 / -1;
    }

    .brand-column p {
      max-width: 100%;
    }

    .footer-grid > :last-child {
      grid-column: auto;
    }

    footer nav a {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      font-size: 0.82rem;
    }

    .legal-row {
      align-items: flex-start;
      flex-direction: column;
      line-height: 1.7;
    }

    .legal-row nav {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }
  }
</style>
