---
import type { AviationAbout } from '../schema';
import SectionLabel from './SectionLabel.astro';

interface Props {
  content: AviationAbout['expectations'];
}

const { content } = Astro.props;
---

<section class="expectations ae-section">
  <div class="ae-container">
    <header><div><SectionLabel>{content.eyebrow}</SectionLabel><h2>{content.heading}</h2></div><a class="ae-text-link" href="/#services">Full service list →</a></header>

    <div class="items">
      {content.items.map((item) => <article><span>{item.label}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
    </div>

    <div class="closing">
      <blockquote>“{content.quote}”</blockquote>
      <aside>
        <h3>Explore next</h3>
        <nav>{content.links.map((link) => <a href={link.href}><span>{link.label}</span><span>→</span></a>)}</nav>
      </aside>
    </div>
  </div>
</section>

<style>
  .expectations {
    background: var(--ae-ink);
  }

  header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--ae-line);
  }

  h2 {
    max-width: 40rem;
    margin-top: 1.35rem;
    font-size: clamp(2.35rem, 3.2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.026em;
    line-height: 1.1;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--ae-line);
  }

  article {
    padding: 1.9rem 2rem 2.1rem;
    background: var(--ae-ink);
  }

  article > span {
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  article h3 {
    margin-top: 1rem;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.016em;
    line-height: 1.3;
  }

  article p {
    margin-top: 0.7rem;
    color: var(--ae-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .closing {
    display: grid;
    grid-template-columns: 1fr 25rem;
    gap: 4rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--ae-line);
  }

  blockquote {
    max-width: 52rem;
    font-size: clamp(1.65rem, 2.2vw, 1.9rem);
    letter-spacing: -0.018em;
    line-height: 1.3;
  }

  aside {
    padding-left: 2rem;
    border-left: 1px solid var(--ae-line);
  }

  aside h3 {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  nav {
    margin-top: 0.7rem;
  }

  nav a {
    display: flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--ae-line-soft);
    color: var(--ae-copy);
    font-size: 0.9rem;
  }

  nav a span:last-child {
    color: var(--ae-accent);
  }

  @media (max-width: 55rem) {
    .closing {
      grid-template-columns: 1fr 19rem;
      gap: 2rem;
    }
  }

  @media (max-width: 47.99rem) {
    .expectations {
      padding-block: 1.75rem;
    }

    header {
      padding-bottom: 1rem;
    }

    header .ae-text-link {
      display: none;
    }

    h2 {
      margin-top: 0.75rem;
      font-size: 1.5rem;
    }

    .items {
      display: block;
      margin-top: 0;
      background: transparent;
    }

    article {
      padding: 1rem 0;
      border-bottom: 1px solid var(--ae-line-soft);
    }

    article h3 {
      margin-top: 0.45rem;
      font-size: 1.05rem;
    }

    article p {
      margin-top: 0.35rem;
      font-size: 0.86rem;
    }

    .closing {
      display: block;
      margin-top: 1.25rem;
      padding-top: 1.15rem;
    }

    blockquote {
      font-size: 1.18rem;
    }

    aside {
      display: none;
    }
  }
</style>
