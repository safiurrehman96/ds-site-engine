---
import type { AviationAbout, AviationFaq, AviationHome } from '../schema';
import { siteConfig } from '../../../lib/site-config';
import MediaSlot from './MediaSlot.astro';
import SectionLabel from './SectionLabel.astro';

interface Props {
  content: AviationHome['cta'] | AviationAbout['cta'] | AviationFaq['cta'];
}

const { content } = Astro.props;
const { contact, ghl } = siteConfig;
const details = content.details ?? [];
const bookingAvailable = ghl.bookingUrls.length > 0;
const secondaryIsPhone = content.secondaryAction === 'phone' || !bookingAvailable;
const secondaryHref = secondaryIsPhone ? `tel:${contact.phone}` : '/booking';
const secondaryLabel = !bookingAvailable && content.secondaryAction === 'booking'
  ? contact.phoneDisplay
  : content.secondaryLabel ?? (secondaryIsPhone ? contact.phoneDisplay : 'Book Service');
const detailValue = (detail: (typeof details)[number]) => {
  if (detail.kind === 'phone') return contact.phoneDisplay;
  if (detail.kind === 'email') return contact.email;
  return detail.value;
};
const detailHref = (detail: (typeof details)[number]) => {
  if (detail.kind === 'phone') return `tel:${contact.phone}`;
  if (detail.kind === 'email') return `mailto:${contact.email}`;
  return undefined;
};
---

<section class="conversion">
  <div class="media-wrap">
    <MediaSlot {...content.media} class="conversion-media" sizes="55vw" />
    {content.availability && <span>{content.availability}</span>}
  </div>
  <div class="copy">
    <SectionLabel>{content.eyebrow}</SectionLabel>
    <h2>{content.heading}</h2>
    <p>{content.body}</p>
    <div class="actions">
      <a class="ae-button ae-button--primary" href="/get-quote">Request a Quote</a>
      <a class="ae-button" href={secondaryHref}>{secondaryLabel}</a>
    </div>
    <div class="contact">
      {
        details.map((detail) => (
          <span>
            {detail.label}<br />
            {detailHref(detail) ? <a href={detailHref(detail)}>{detailValue(detail)}</a> : detailValue(detail)}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .conversion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(30rem, 40rem);
    border-top: 1px solid var(--ae-line);
    background: var(--ae-ink);
  }

  .media-wrap {
    position: relative;
    min-height: 26.25rem;
  }

  .media-wrap :global(.conversion-media) {
    position: absolute;
    inset: 0;
    height: 100%;
    border: 0;
  }

  .media-wrap > span {
    position: absolute;
    z-index: 2;
    right: var(--ae-gutter);
    bottom: 1.75rem;
    left: var(--ae-gutter);
    font-family: var(--ae-mono);
    font-size: 0.67rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .copy {
    display: flex;
    padding: 4.75rem var(--ae-gutter) 4.5rem;
    border-left: 1px solid var(--ae-line);
    flex-direction: column;
  }

  h2 {
    margin-top: 1.5rem;
    font-size: clamp(2.4rem, 3.4vw, 2.9rem);
    font-weight: 500;
    letter-spacing: -0.026em;
    line-height: 1.06;
  }

  .copy > p {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--ae-muted);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 0.85rem;
    margin-top: 2.35rem;
  }

  .contact {
    display: flex;
    gap: 2.5rem;
    margin-top: auto;
    padding-top: 2.75rem;
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  .contact a {
    color: var(--ae-bone);
  }

  @media (max-width: 55rem) {
    .conversion {
      grid-template-columns: 1fr 28rem;
    }
  }

  @media (max-width: 47.99rem) {
    .conversion {
      display: block;
    }

    .media-wrap {
      display: none;
    }

    .copy {
      padding: 2rem var(--ae-gutter) 2.2rem;
      border-left: 0;
    }

    h2 {
      margin-top: 0.9rem;
      font-size: 1.75rem;
    }

    .copy > p {
      margin-top: 0.85rem;
      font-size: 0.9rem;
    }

    .actions {
      flex-direction: column;
      gap: 0.65rem;
      margin-top: 1.4rem;
    }

    .contact {
      padding-top: 1.5rem;
      flex-wrap: wrap;
      gap: 1.25rem 2rem;
    }
  }
</style>
