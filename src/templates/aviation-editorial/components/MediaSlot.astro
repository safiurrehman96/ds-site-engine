---
import Img from '../../../components/Img.astro';

interface Props {
  label: string;
  image?: { src: string; alt: string };
  class?: string;
  eager?: boolean;
  sizes?: string;
  showCaption?: boolean;
}

const {
  label,
  image,
  class: className,
  eager = false,
  sizes = '100vw',
  showCaption = true,
} = Astro.props;
---

<figure class:list={['media', className]} data-placeholder={image ? 'false' : 'true'}>
  {
    image ? (
      <Img
        {...image}
        widths={[480, 768, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : null
  }
  {showCaption && <figcaption>{image ? label : `[ image ] ${label}`}</figcaption>}
</figure>

<style>
  .media {
    position: relative;
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid var(--ae-line-soft);
    background: repeating-linear-gradient(
      135deg,
      var(--ae-panel-raised) 0 11px,
      var(--ae-panel) 11px 22px
    );
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  .media::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgba(8, 9, 10, 0.72));
    content: '';
    pointer-events: none;
  }

  .media[data-placeholder='true']::after {
    display: none;
  }

  figcaption {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 0.85rem;
    left: 1rem;
    color: var(--ae-bone);
    font-family: var(--ae-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  [data-placeholder='true'] figcaption {
    top: 0.9rem;
    bottom: auto;
    color: var(--ae-faint);
  }
</style>
