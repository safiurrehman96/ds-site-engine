---
import Img from '../../../components/Img.astro';

interface Props {
  label: string;
  image?: { src: string; alt: string };
  class?: string;
  eager?: boolean;
  sizes?: string;
  showCaption?: boolean;
}

const {
  label,
  image,
  class: className,
  eager = false,
  sizes = '100vw',
  showCaption = true,
} = Astro.props;
---

<figure class:list={['media', className]} data-placeholder={image ? 'false' : 'true'}>
  {
    image ? (
      <Img
        {...image}
        widths={[480, 768, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : null
  }
  {/* Captions are scaffolding: they name what a slot is waiting for while the payload
      still lacks the shot. Once a real image lands, the picture speaks for itself and
      the label would only sit on top of it — so it is dropped. `label` stays required
      because every slot needs that name until it is filled. */}
  {showCaption && !image && <figcaption>[ image ] {label}</figcaption>}
</figure>

<style>
  .media {
    position: relative;
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid var(--ae-line-soft);
    background: repeating-linear-gradient(
      135deg,
      var(--ae-panel-raised) 0 11px,
      var(--ae-panel) 11px 22px
    );
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  /* The bottom scrim existed only to keep the caption legible over the photo. With no
     caption over an image there is nothing left to make legible, and it was darkening
     the lower half of every shot for free. */

  /* Only ever rendered on an unfilled slot, so it sits top-left on the hatched
     background rather than bottom-left over a photo. */
  figcaption {
    position: absolute;
    z-index: 1;
    top: 0.9rem;
    right: 1rem;
    left: 1rem;
    color: var(--ae-faint);
    font-family: var(--ae-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }
</style>
