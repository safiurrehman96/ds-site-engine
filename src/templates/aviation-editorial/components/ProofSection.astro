---
import type { AviationHome } from '../schema';
import MediaSlot from './MediaSlot.astro';

interface Props {
  content: AviationHome['proof'];
}

const { content } = Astro.props;
---

<section class="proof">
  <div class="gallery">
    {content.gallery.map((media, index) => (
      <MediaSlot {...media} class:list={['gallery-media', index === 0 && 'gallery-lead']} sizes={index === 0 ? '50vw' : '25vw'} />
    ))}
  </div>

  <div class="record ae-container">
    <div>
      <p class="label">Field record</p>
      <blockquote>“{content.quote}”</blockquote>
      <p class="attribution">{content.attribution}</p>
    </div>
    <aside>
      <h2>Also serving</h2>
      <dl>{content.audiences.map((audience) => <div><dt>{audience.label}</dt><dd>{audience.code}</dd></div>)}</dl>
      <a class="ae-text-link" href="/faqs">Read the FAQs →</a>
    </aside>
  </div>
</section>

<style>
  .proof {
    border-top: 1px solid var(--ae-line);
    background: var(--ae-deck);
  }

  .gallery {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    grid-template-rows: 14.4rem 14.4rem;
    gap: 1px;
    background: var(--ae-line);
  }

  .gallery :global(.gallery-media) {
    height: 100%;
    border: 0;
  }

  .gallery :global(.gallery-lead) {
    grid-row: span 2;
  }

  .record {
    display: grid;
    grid-template-columns: 1fr 26.25rem;
    gap: clamp(3rem, 5.5vw, 5rem);
    padding-block: clamp(3.5rem, 5.8vw, 5.25rem);
  }

  .label,
  .attribution,
  aside h2 {
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.67rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  blockquote {
    max-width: 52rem;
    margin-top: 1.6rem;
    font-size: clamp(1.7rem, 2.3vw, 2rem);
    letter-spacing: -0.018em;
    line-height: 1.3;
  }

  .attribution {
    margin-top: 1.6rem;
    color: var(--ae-muted);
    letter-spacing: 0.14em;
  }

  aside {
    display: flex;
    padding-left: 2rem;
    border-left: 1px solid var(--ae-line);
    flex-direction: column;
  }

  aside h2 {
    color: var(--ae-muted);
    font-weight: 400;
  }

  dl {
    margin: 1.35rem 0 2rem;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--ae-line-soft);
    color: var(--ae-copy);
    font-size: 0.9rem;
  }

  dt,
  dd {
    margin: 0;
  }

  dd {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
  }

  aside .ae-text-link {
    margin-top: auto;
  }

  @media (max-width: 55rem) {
    .record {
      grid-template-columns: 1fr 19rem;
      gap: 2rem;
    }
  }

  @media (max-width: 47.99rem) {
    .gallery {
      display: block;
    }

    .gallery :global(.gallery-media) {
      display: none;
    }

    .gallery :global(.gallery-lead) {
      display: block;
      height: 13.75rem;
    }

    .record {
      display: block;
      padding-block: 1.9rem;
    }

    blockquote {
      margin-top: 0.85rem;
      font-size: 1.25rem;
    }

    .attribution {
      margin-top: 1rem;
      font-size: 0.61rem;
      line-height: 1.6;
    }

    aside {
      display: none;
    }
  }
</style>
