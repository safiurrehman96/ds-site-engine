---
import type { CollectionEntry } from 'astro:content';
import type { AviationHome } from '../schema';
import MediaSlot from './MediaSlot.astro';
import CoverageChart from './CoverageChart.astro';
import SectionLabel from './SectionLabel.astro';

interface Props {
  content: AviationHome['coverage'];
  areas: CollectionEntry<'areas'>[];
}

const { content, areas } = Astro.props;
const bySlug = new Map(areas.map((area) => [area.data.slug, area]));
const airportRows = content.airports.map((item) => {
  const area = bySlug.get(item.slug);
  if (!area) throw new Error(`Homepage references missing airport "${item.slug}".`);
  return { ...item, area };
});
---

<section id="airports" class="coverage ae-section">
  <div class="grid ae-container">
    <div class="intro">
      <SectionLabel>{content.eyebrow}</SectionLabel>
      <h2>{content.heading}</h2>
      <p>{content.intro}</p>
      {
        content.chart ? (
          <CoverageChart {...content.chart} class="map" />
        ) : (
          <MediaSlot {...content.map} class="map" sizes="28rem" />
        )
      }
      <div class="legend">
        <span><i></i>Badged — no escort required</span>
        <span><i></i>Escorted / by arrangement</span>
      </div>
    </div>

    <div class="airports">
      {airportRows.map(({ area, ...item }) => (
        <a href={`/${area.data.slug}`}>
          <strong>{area.data.shortName}</strong>
          <span class="name"><b>{area.data.name.replace(/\s*\([^)]*\)$/, '')}</b><small>{item.description}</small></span>
          <span class="mode">{item.serviceMode}<small>{item.serviceNote}</small></span>
          <span class="status" data-status={item.status}><i></i>{item.status}</span>
        </a>
      ))}
      <div class="coverage-note"><span>{content.note}</span><a class="ae-text-link" href="/get-quote">Check coverage →</a></div>
    </div>
  </div>
</section>

<style>
  .coverage {
    background: var(--ae-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(19rem, 25rem) 1fr;
    gap: clamp(3rem, 5.5vw, 5rem);
    align-items: start;
  }

  h2 {
    margin-top: 1.35rem;
    font-size: clamp(2.15rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.024em;
    line-height: 1.12;
  }

  .intro > p {
    margin-top: 1.25rem;
    color: var(--ae-muted);
    line-height: 1.7;
  }

  .intro :global(.map) {
    height: 14.4rem;
    margin-top: 1.75rem;
  }

  .legend {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
  }

  .legend span {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .legend i,
  .status i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--ae-accent);
  }

  .legend span:last-child i,
  .status[data-status='escorted'] i {
    border: 1px solid var(--ae-muted);
    background: transparent;
  }

  .airports {
    border-top: 1px solid var(--ae-line);
  }

  .airports > a {
    display: grid;
    min-height: 6.1rem;
    grid-template-columns: 10.6rem 1fr 12.5rem 8rem;
    align-items: center;
    gap: 1.75rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--ae-line-soft);
    transition: background-color 160ms ease;
  }

  .airports > a:hover {
    background: var(--ae-panel);
  }

  .airports > a > strong {
    font-family: var(--ae-mono);
    font-size: 2.35rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .name b,
  .name small,
  .mode small {
    display: block;
  }

  .name b {
    font-size: 1.18rem;
    font-weight: 500;
  }

  .name small,
  .mode small {
    margin-top: 0.25rem;
    color: var(--ae-muted);
    font-size: 0.84rem;
  }

  .mode {
    color: #b6b3ae;
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .mode small {
    font-family: var(--ae-mono);
    font-size: 0.68rem;
  }

  .status {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.55rem;
    font-family: var(--ae-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .status[data-status='escorted'] {
    color: var(--ae-muted);
  }

  .coverage-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0.5rem;
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 68rem) {
    .grid {
      grid-template-columns: 19rem 1fr;
      gap: 2.5rem;
    }

    .airports > a {
      grid-template-columns: 7rem 1fr 6rem;
      gap: 1rem;
    }

    .mode {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .coverage {
      padding-block: 2rem;
    }

    .grid {
      display: block;
    }

    h2 {
      margin-top: 0.85rem;
      font-size: 1.65rem;
    }

    .intro > p {
      font-size: 0.88rem;
    }

    .intro :global(.map),
    .legend {
      display: none;
    }

    .airports {
      margin-top: 1.25rem;
    }

    .airports > a {
      grid-template-columns: 1fr auto;
      gap: 0.6rem;
      padding: 0.75rem 0;
    }

    .airports > a > strong {
      font-size: 1.5rem;
    }

    .name {
      grid-column: 1;
    }

    .name b {
      display: none;
    }

    .name small {
      font-size: 0.78rem;
    }

    .status {
      grid-row: 1 / span 2;
      grid-column: 2;
      font-size: 0.6rem;
    }

    .coverage-note {
      display: block;
      padding-inline: 0;
      font-size: 0.64rem;
    }

    .coverage-note .ae-text-link {
      display: none;
    }
  }
</style>
