---
import type { CollectionEntry } from 'astro:content';
import type { AviationHome } from '../schema';
import Img from '../../../components/Img.astro';
import { siteConfig } from '../../../lib/site-config';

interface Props {
  chrome: AviationHome['chrome'];
  services: CollectionEntry<'services'>[];
  areas: CollectionEntry<'areas'>[];
}

const { chrome, services, areas } = Astro.props;
const { brand, contact } = siteConfig;
const currentPath = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const isServicePage = services.some((service) => service.data.slug === currentPath);
const isAirportPage = areas.some((area) => area.data.slug === currentPath);
---

<div class="site-head" data-site-head>
  <div class="utility">
    <span><i aria-hidden="true"></i>{chrome.stationLabel}</span>
    <span class="utility-contact"><span>{chrome.emergencyLabel}</span><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></span>
  </div>

  <header>
  <a class="brand" href="/" aria-label={`${brand.name} home`}>
    <Img
      src={brand.logoPath}
      alt={brand.name}
      widths={[160, 320]}
      sizes="160px"
      loading="eager"
      fetchpriority="high"
    />
  </a>

  <nav class="desktop-nav" aria-label="Main navigation">
    <details class:list={['desktop-menu', 'service-menu', isServicePage && 'active']}>
      <summary>Services <i aria-hidden="true"></i></summary>
      <ul class="nav-dropdown service-dropdown">
        {
          services.map((service, index) => (
            <li>
              <a href={`/${service.data.slug}`} aria-current={service.data.slug === currentPath ? 'page' : undefined}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{service.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <details class:list={['desktop-menu', 'airport-menu', isAirportPage && 'active']}>
      <summary>Airports <i aria-hidden="true"></i></summary>
      <ul class="nav-dropdown airport-dropdown">
        {
          areas.map((area) => (
            <li>
              <a href={`/${area.data.slug}`} aria-current={area.data.slug === currentPath ? 'page' : undefined}>
                <span>{area.data.shortName}</span>
                <span>{area.data.airport?.officialName ?? area.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <a href="/about">About</a>
    <a href="/faqs">FAQs</a>
  </nav>

  <div class="desktop-actions">
    <a class="header-cta" href="/get-quote">Request Quote</a>
  </div>

  <div class="mobile-actions">
    <a class="phone" href={`tel:${contact.phone}`} aria-label={`Call ${brand.name}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3h-2A1.5 1.5 0 0 0 3 4.6c.2 3.3 1.5 6.4 3.7 8.8 2.1 2.3 5 3.8 8.1 4.2h.1A1.5 1.5 0 0 0 16.5 16v-2a1.5 1.5 0 0 0-1.2-1.5l-2-.4a1.5 1.5 0 0 0-1.4.5l-.6.7a11 11 0 0 1-4-4l.7-.6a1.5 1.5 0 0 0 .4-1.4l-.4-2A1.5 1.5 0 0 0 6.5 3Z" /></svg>
    </a>
    <details class="mobile-menu">
      <summary><span class="sr-only">Open navigation</span><i></i><i></i></summary>
      <nav aria-label="Mobile navigation">
        <details class="mobile-submenu mobile-services">
          <summary>Services <i aria-hidden="true"></i></summary>
          <div>
            {
              services.map((service, index) => (
                <a href={`/${service.data.slug}`} aria-current={service.data.slug === currentPath ? 'page' : undefined}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{service.data.name}</span>
                </a>
              ))
            }
          </div>
        </details>
        <details class="mobile-submenu mobile-airports">
          <summary>Airports <i aria-hidden="true"></i></summary>
          <div>
            {
              areas.map((area) => (
                <a href={`/${area.data.slug}`} aria-current={area.data.slug === currentPath ? 'page' : undefined}>
                  <span>{area.data.shortName}</span>
                  <span>{area.data.airport?.officialName ?? area.data.name}</span>
                </a>
              ))
            }
          </div>
        </details>
        <a href="/about">About</a>
        <a href="/faqs">FAQs</a>
        <a href="/get-quote">Request Quote</a>
      </nav>
      </details>
    </div>
  </header>
</div>

<div class="head-spacer" aria-hidden="true"></div>

<script>
  // Condense the header once the page has scrolled past the utility strip. Hysteresis
  // (24px on, 8px off) rather than a single threshold: a bare `> 0` test flickers when
  // the shrink itself changes document height near the top of the page.
  const head = document.querySelector<HTMLElement>('[data-site-head]');

  if (head) {
    let condensed = false;
    let ticking = false;

    const sync = () => {
      ticking = false;
      const y = window.scrollY;
      if (!condensed && y > 24) condensed = true;
      else if (condensed && y < 8) condensed = false;
      else return;
      head.classList.toggle('condensed', condensed);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(sync);
      },
      { passive: true },
    );

    sync(); // restored scroll position on a back-navigation starts mid-page
  }

  const desktopMenus = document.querySelectorAll<HTMLDetailsElement>('.desktop-menu');
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('.desktop-menu, .mobile-menu');
  const desktopQuery = window.matchMedia('(min-width: 68.01rem)');

  const closeDesktopSiblings = (active: HTMLDetailsElement) => {
    desktopMenus.forEach((menu) => {
      if (menu !== active) menu.open = false;
    });
  };

  desktopMenus.forEach((menu) => {
    menu.addEventListener('pointerenter', () => {
      if (!desktopQuery.matches) return;
      closeDesktopSiblings(menu);
      menu.open = true;
    });

    menu.addEventListener('pointerleave', () => {
      if (desktopQuery.matches && !menu.contains(document.activeElement)) menu.open = false;
    });

    menu.addEventListener('focusin', () => {
      if (!desktopQuery.matches) return;
      closeDesktopSiblings(menu);
      menu.open = true;
    });

    menu.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!menu.matches(':hover') && !menu.contains(document.activeElement)) menu.open = false;
      });
    });

    menu.querySelector(':scope > summary')?.addEventListener('click', (event) => {
      if (desktopQuery.matches) event.preventDefault();
    });
  });

  document.addEventListener('click', (event) => {
    disclosures.forEach((disclosure) => {
      if (!disclosure.contains(event.target as Node)) disclosure.open = false;
    });
  });

  disclosures.forEach((disclosure) => {
    disclosure.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      disclosure.open = false;
      disclosure.querySelector<HTMLElement>(':scope > summary')?.focus();
    });
  });
</script>

<style>
  /**
   * Fixed rather than sticky, with a spacer holding its resting height in flow.
   *
   * Sticky keeps the header in normal flow, so collapsing it shortens the document —
   * near the top of the page the browser compensates by moving the scroll position,
   * which re-crosses the condense threshold and the header oscillates mid-transition.
   * Out of flow, the document height is constant and the collapse is a one-way trip.
   */
  .site-head {
    position: fixed;
    z-index: 60;
    top: 0;
    right: 0;
    left: 0;
    /* Header height, published so the dropdowns can measure their gap from the
       header's bottom edge rather than from the summary they hang off. */
    --ae-head-h: 5.75rem;
    --ae-menu-gap: 0.85rem;
  }

  .site-head.condensed {
    --ae-head-h: 4.25rem;
  }

  .head-spacer {
    height: calc(2.25rem + 5.75rem + 2px); /* utility + header + their 1px borders */
  }

  .utility {
    display: flex;
    height: 2.25rem;
    overflow: hidden;
    align-items: center;
    transition:
      height 200ms ease,
      opacity 200ms ease;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line-soft);
    background: var(--ae-deck);
    color: #7e8185;
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .utility > span,
  .utility-contact {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .utility i {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--ae-accent);
  }

  .utility-contact {
    gap: 1.75rem;
  }

  .utility a {
    color: var(--ae-copy);
  }

  /* border-width, not just colour: a transparent 1px border still occupies 1px, which
     is the sliver of page background that showed above the condensed header. */
  .site-head.condensed .utility {
    height: 0;
    border-bottom-width: 0;
    opacity: 0;
  }

  header {
    position: relative;
    z-index: 50;
    display: grid;
    min-height: 5.75rem;
    transition: min-height 200ms ease;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2.5rem;
    padding-inline: var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line);
    background: var(--ae-ink);
  }

  .brand {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  .brand :global(img) {
    width: auto;
    height: 3.75rem;
    transition: height 200ms ease;
  }

  .site-head.condensed header {
    min-height: 4.25rem;
    box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.35);
  }

  .site-head.condensed .brand :global(img) {
    height: 2.6rem;
  }

  .desktop-nav,
  .desktop-actions {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    gap: clamp(1.2rem, 2.4vw, 2.15rem);
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .desktop-nav a {
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    color: #b6b3ae;
  }

  .desktop-nav a:hover {
    border-color: var(--ae-accent);
    color: #fff;
  }

  .desktop-menu {
    position: relative;
  }

  /* Hover bridge: spans exactly the gap the dropdown was pushed down by, so the
     pointer never crosses dead space between summary and panel. `100%` here is the
     summary's height, so this tracks the header shrink with no second constant. */
  .desktop-menu[open]::after {
    position: absolute;
    top: 100%;
    right: -1rem;
    left: -1rem;
    height: calc((var(--ae-head-h) - 100%) / 2 + var(--ae-menu-gap));
    content: '';
  }

  .desktop-menu > summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    color: #b6b3ae;
  }

  .desktop-menu > summary::-webkit-details-marker {
    display: none;
  }

  .desktop-menu > summary i {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  .desktop-menu[open] > summary,
  .desktop-menu.active > summary {
    border-color: var(--ae-accent);
    color: #fff;
  }

  .desktop-menu[open] > summary i {
    transform: translateY(0.12rem) rotate(225deg);
  }

  .nav-dropdown {
    position: absolute;
    z-index: 60;
    /* Measured from the header's bottom edge, not the summary: the summary sits
       centred in the header, so a fixed offset from it drifts as the header shrinks
       (it overhung the header bar at rest and floated free once condensed). */
    top: calc(100% + (var(--ae-head-h) - 100%) / 2 + var(--ae-menu-gap));
    left: 50%;
    transition: top 200ms ease;
    width: 22rem;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--ae-line);
    background: var(--ae-deck);
    box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.45);
    transform: translateX(-50%);
    list-style: none;
  }

  .nav-dropdown li {
    display: block;
  }

  .desktop-nav .nav-dropdown a {
    display: grid;
    min-height: 3.5rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--ae-line-soft);
    grid-template-columns: 3.4rem 1fr;
    gap: 0.8rem;
    align-items: center;
    letter-spacing: 0;
    text-transform: none;
  }

  .desktop-nav .nav-dropdown li:last-child a {
    border-bottom: 0;
  }

  .nav-dropdown a:hover,
  .nav-dropdown a:focus-visible,
  .nav-dropdown a[aria-current='page'] {
    border-color: var(--ae-line-soft);
    background: var(--ae-panel);
  }

  .nav-dropdown a span:first-child {
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .nav-dropdown a span:last-child {
    color: var(--ae-copy);
    font-family: var(--ae-sans);
    font-size: 0.88rem;
  }

  .desktop-actions {
    justify-self: end;
    gap: 1.35rem;
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.625rem;
    align-items: center;
    padding-inline: 1.35rem;
    background: var(--ae-bone);
    color: var(--ae-ink);
  }

  .mobile-actions {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 68rem) {
    header {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .desktop-actions,
    .utility {
      display: none;
    }

    .desktop-menu {
      display: none;
    }

    .head-spacer {
      height: calc(5.75rem + 1px); /* utility strip is hidden at this width */
    }

    .mobile-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .phone {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
    }

    .phone svg {
      width: 1.25rem;
      fill: none;
      stroke: var(--ae-copy);
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.6;
    }

    .mobile-menu {
      position: static;
    }

    .mobile-menu > summary {
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      cursor: pointer;
      flex-direction: column;
      justify-content: center;
      gap: 0.38rem;
      list-style: none;
    }

    .mobile-menu > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu > summary i {
      width: 1.4rem;
      height: 1px;
      background: var(--ae-bone);
      transition: transform 160ms ease;
    }

    .mobile-menu[open] > summary i:first-of-type {
      transform: translateY(0.22rem) rotate(45deg);
    }

    .mobile-menu[open] > summary i:last-of-type {
      transform: translateY(-0.22rem) rotate(-45deg);
    }

    .mobile-menu > nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      padding: 0.75rem var(--ae-gutter) 1.5rem;
      border-bottom: 1px solid var(--ae-line);
      background: var(--ae-deck);
      box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.35);
      max-height: calc(100dvh - 3.75rem);
      overflow-y: auto;
    }

    .mobile-menu > nav > a {
      min-height: 3.25rem;
      padding-block: 1rem;
      border-bottom: 1px solid var(--ae-line-soft);
      font-family: var(--ae-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .mobile-submenu {
      border-bottom: 1px solid var(--ae-line-soft);
    }

    .mobile-submenu > summary {
      display: flex;
      min-height: 3.25rem;
      cursor: pointer;
      list-style: none;
      align-items: center;
      justify-content: space-between;
      padding-block: 1rem;
      font-family: var(--ae-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .mobile-submenu > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-submenu > summary i::before {
      color: var(--ae-accent);
      content: '+';
      font-style: normal;
    }

    .mobile-submenu[open] > summary i::before {
      content: '-';
    }

    .mobile-submenu > div {
      padding: 0 0 0.75rem 0.75rem;
    }

    .mobile-submenu a {
      display: grid;
      min-height: 3.25rem;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--ae-line-soft);
      grid-template-columns: 3.5rem 1fr;
      align-items: center;
      gap: 0.7rem;
    }

    .mobile-submenu a span:first-child {
      color: var(--ae-accent);
      font-family: var(--ae-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
    }

    .mobile-submenu a span:last-child {
      color: var(--ae-copy);
      font-size: 0.88rem;
    }
  }

  @media (max-width: 47.99rem) {
    header {
      min-height: 3.75rem;
    }

    .head-spacer {
      height: calc(3.75rem + 1px);
    }

    .brand :global(img) {
      height: 2.75rem;
    }

    .site-head.condensed header {
      min-height: 3.25rem;
    }

    .site-head.condensed .brand :global(img) {
      height: 2.1rem;
    }
  }
</style>
