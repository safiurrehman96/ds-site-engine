---
import type { CollectionEntry } from 'astro:content';
import type { AviationHome } from '../schema';
import { siteConfig } from '../../../lib/site-config';

interface Props {
  chrome: AviationHome['chrome'];
  areas: CollectionEntry<'areas'>[];
}

const { chrome, areas } = Astro.props;
const { brand, contact } = siteConfig;
const currentPath = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const isAirportPage = areas.some((area) => area.data.slug === currentPath);
---

<div class="utility">
  <span><i aria-hidden="true"></i>{chrome.stationLabel}</span>
  <span class="utility-contact"><span>{chrome.emergencyLabel}</span><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></span>
</div>

<header>
  <a class="brand" href="/" aria-label={`${brand.name} home`}><i aria-hidden="true"></i>{brand.name}</a>

  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="/#services">Services</a>
    <details class:list={['airport-menu', isAirportPage && 'active']}>
      <summary>Airports <i aria-hidden="true"></i></summary>
      <ul class="airport-dropdown">
        {
          areas.map((area) => (
            <li>
              <a href={`/${area.data.slug}`} aria-current={area.data.slug === currentPath ? 'page' : undefined}>
                <span>{area.data.shortName}</span>
                <span>{area.data.airport?.officialName ?? area.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <a href="/about">About</a>
    <a href="/faqs">FAQs</a>
  </nav>

  <div class="desktop-actions">
    <a class="quote" href="/get-quote">Request Quote</a>
    <a class="book" href="/booking">Book Service</a>
  </div>

  <div class="mobile-actions">
    <a class="phone" href={`tel:${contact.phone}`} aria-label={`Call ${brand.name}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3h-2A1.5 1.5 0 0 0 3 4.6c.2 3.3 1.5 6.4 3.7 8.8 2.1 2.3 5 3.8 8.1 4.2h.1A1.5 1.5 0 0 0 16.5 16v-2a1.5 1.5 0 0 0-1.2-1.5l-2-.4a1.5 1.5 0 0 0-1.4.5l-.6.7a11 11 0 0 1-4-4l.7-.6a1.5 1.5 0 0 0 .4-1.4l-.4-2A1.5 1.5 0 0 0 6.5 3Z" /></svg>
    </a>
    <details class="mobile-menu">
      <summary><span class="sr-only">Open navigation</span><i></i><i></i></summary>
      <nav aria-label="Mobile navigation">
        <a href="/#services">Services</a>
        <details class="mobile-airports">
          <summary>Airports <i aria-hidden="true"></i></summary>
          <div>
            {
              areas.map((area) => (
                <a href={`/${area.data.slug}`} aria-current={area.data.slug === currentPath ? 'page' : undefined}>
                  <span>{area.data.shortName}</span>
                  <span>{area.data.airport?.officialName ?? area.data.name}</span>
                </a>
              ))
            }
          </div>
        </details>
        <a href="/about">About</a>
        <a href="/faqs">FAQs</a>
        <a href="/get-quote">Request Quote</a>
        <a href="/booking">Book Service</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('.airport-menu, .mobile-menu');

  document.addEventListener('click', (event) => {
    disclosures.forEach((disclosure) => {
      if (!disclosure.contains(event.target as Node)) disclosure.open = false;
    });
  });

  disclosures.forEach((disclosure) => {
    disclosure.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      disclosure.open = false;
      disclosure.querySelector<HTMLElement>(':scope > summary')?.focus();
    });
  });
</script>

<style>
  .utility {
    display: flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line-soft);
    background: var(--ae-deck);
    color: #7e8185;
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .utility > span,
  .utility-contact {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .utility i {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--ae-accent);
  }

  .utility-contact {
    gap: 1.75rem;
  }

  .utility a {
    color: var(--ae-copy);
  }

  header {
    position: relative;
    z-index: 50;
    display: grid;
    min-height: 5.125rem;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2.5rem;
    padding-inline: var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line);
    background: var(--ae-ink);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand i {
    width: 0.56rem;
    height: 0.56rem;
    background: var(--ae-accent);
    transform: rotate(45deg);
  }

  .desktop-nav,
  .desktop-actions {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    gap: clamp(1.2rem, 2.4vw, 2.15rem);
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .desktop-nav a {
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    color: #b6b3ae;
  }

  .desktop-nav a:hover {
    border-color: var(--ae-accent);
    color: #fff;
  }

  .airport-menu {
    position: relative;
  }

  .airport-menu > summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    color: #b6b3ae;
  }

  .airport-menu > summary::-webkit-details-marker {
    display: none;
  }

  .airport-menu > summary i {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  .airport-menu[open] > summary,
  .airport-menu.active > summary {
    border-color: var(--ae-accent);
    color: #fff;
  }

  .airport-menu[open] > summary i {
    transform: translateY(0.12rem) rotate(225deg);
  }

  .airport-dropdown {
    position: absolute;
    z-index: 60;
    top: calc(100% + 1.4rem);
    left: 50%;
    width: 22rem;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--ae-line);
    background: var(--ae-deck);
    box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.45);
    transform: translateX(-50%);
    list-style: none;
  }

  .airport-dropdown li {
    display: block;
  }

  .desktop-nav .airport-dropdown a {
    display: grid;
    min-height: 3.5rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--ae-line-soft);
    grid-template-columns: 3.4rem 1fr;
    gap: 0.8rem;
    align-items: center;
    letter-spacing: 0;
    text-transform: none;
  }

  .desktop-nav .airport-dropdown a:last-child {
    border-bottom: 0;
  }

  .airport-dropdown a:hover,
  .airport-dropdown a[aria-current='page'] {
    border-color: var(--ae-line-soft);
    background: var(--ae-panel);
  }

  .airport-dropdown a span:first-child {
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .airport-dropdown a span:last-child {
    color: var(--ae-copy);
    font-family: var(--ae-sans);
    font-size: 0.88rem;
  }

  .desktop-actions {
    justify-self: end;
    gap: 1.35rem;
    font-family: var(--ae-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .quote {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ae-accent) 60%, transparent);
  }

  .book {
    display: inline-flex;
    min-height: 2.625rem;
    align-items: center;
    padding-inline: 1.35rem;
    background: var(--ae-bone);
    color: var(--ae-ink);
  }

  .mobile-actions {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 68rem) {
    header {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .desktop-actions,
    .utility {
      display: none;
    }

    .airport-menu {
      display: none;
    }

    .mobile-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .phone {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
    }

    .phone svg {
      width: 1.25rem;
      fill: none;
      stroke: var(--ae-copy);
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.6;
    }

    .mobile-menu {
      position: static;
    }

    .mobile-menu > summary {
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      cursor: pointer;
      flex-direction: column;
      justify-content: center;
      gap: 0.38rem;
      list-style: none;
    }

    .mobile-menu > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu > summary i {
      width: 1.4rem;
      height: 1px;
      background: var(--ae-bone);
      transition: transform 160ms ease;
    }

    .mobile-menu[open] > summary i:first-of-type {
      transform: translateY(0.22rem) rotate(45deg);
    }

    .mobile-menu[open] > summary i:last-of-type {
      transform: translateY(-0.22rem) rotate(-45deg);
    }

    .mobile-menu > nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      padding: 0.75rem var(--ae-gutter) 1.5rem;
      border-bottom: 1px solid var(--ae-line);
      background: var(--ae-deck);
      box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.35);
    }

    .mobile-menu > nav > a {
      min-height: 3.25rem;
      padding-block: 1rem;
      border-bottom: 1px solid var(--ae-line-soft);
      font-family: var(--ae-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .mobile-airports {
      border-bottom: 1px solid var(--ae-line-soft);
    }

    .mobile-airports > summary {
      display: flex;
      min-height: 3.25rem;
      cursor: pointer;
      list-style: none;
      align-items: center;
      justify-content: space-between;
      padding-block: 1rem;
      font-family: var(--ae-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .mobile-airports > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-airports > summary i::before {
      color: var(--ae-accent);
      content: '+';
      font-style: normal;
    }

    .mobile-airports[open] > summary i::before {
      content: '-';
    }

    .mobile-airports > div {
      padding: 0 0 0.75rem 0.75rem;
    }

    .mobile-airports a {
      display: grid;
      min-height: 3.25rem;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--ae-line-soft);
      grid-template-columns: 3.5rem 1fr;
      align-items: center;
      gap: 0.7rem;
    }

    .mobile-airports a span:first-child {
      color: var(--ae-accent);
      font-family: var(--ae-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
    }

    .mobile-airports a span:last-child {
      color: var(--ae-copy);
      font-size: 0.88rem;
    }
  }

  @media (max-width: 47.99rem) {
    header {
      min-height: 3.75rem;
    }

    .brand {
      gap: 0.55rem;
      font-size: 1.05rem;
      letter-spacing: 0.2em;
    }

    .brand i {
      width: 0.48rem;
      height: 0.48rem;
    }
  }
</style>
